// Import memcpy layout module for 1 x 1 grid of PEs
// This module defines parameters passed to program on the single PE
const memcpy = @import_module("<memcpy/get_params>", .{
  .width = 1,
  .height = 1,
});

// genome whose exported symbol names unit tests need (genome
// alleleevoepi_2026_11_21 exports the same name)
const rng = @import_module("cerebraslib/rng_xoroshiro64starstar.csl");
const genome_alleleevoepi = @import_module(
  "cerebraslib/genome/genome_alleleevoepi_2026_11_19.csl", .{ .rng = rng }
);

layout {
  // how many PE?
  @set_rectangle(1, 1);

  // assign code to each PE
  @set_tile_code(0, 0, "kernel.csl", .{
    .memcpy_params = memcpy.get_params(0),
  });

  @export_name("dolaunch", fn()void);
  genome_alleleevoepi.export_symbol_names();
}
