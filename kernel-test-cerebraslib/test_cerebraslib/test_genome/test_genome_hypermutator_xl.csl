const genome = @import_module("cerebraslib/genome/genome_hypermutator_xl.csl");

fn test_trample_resident() void {
    var resident = @zeros(genome.genome_t);
    var spawn = @zeros(genome.genome_t);
    for (@range(u16, genome.gSize)) |i| {
        spawn[i] = 0x01234567 ^ (@as(u32, i) << 8);
        resident[i] = ~spawn[i];
    }
    genome.trample_resident(
        @ptrcast([*]u32, &resident), @ptrcast([*]u32, &spawn)
    );
    for (@range(u16, genome.gSize)) |i| {
        @assert(resident[i] == spawn[i]);
        @assert(spawn[i] == 0x01234567 ^ (@as(u32, i) << 8));
    }
}

fn do_test() void {
    test_trample_resident();
}
