const math = @import_module("<math>");
const random = @import_module("<random>");

const genome_mlsnk = @import_module("cerebraslib/genome/genome_mlsnk_2026_10_15.csl");


fn test_builtin_random_seeding() void {
    random.set_global_prng_seed(1);
    const first = @random16();
    @assert(first != @random16());
    random.set_global_prng_seed(1);
    @assert(first == @random16());
}

fn test_log2_u32() void {
    @assert(genome_mlsnk._log2_u32(1) == 0.0);
    @assert(genome_mlsnk._log2_u32(2) == 1.0);
    @assert(genome_mlsnk._log2_u32(32) == 5.0);
    @assert(genome_mlsnk._log2_u32(256) == 8.0);
    @assert(math.abs(genome_mlsnk._log2_u32(3) - 1.5849625) < 1e-4);
    @assert(math.abs(genome_mlsnk._log2_u32(1000) - 9.9657843) < 1e-4);
}

fn test_mls_selection_p() void {
    // default compconf: popSize 256 (8 doublings), 25 reference doublings
    // expected s'_i = (1 + s_i) ^ (8 / 25) - 1
    @assert(math.abs(genome_mlsnk._get_mls_selection_p(0) - 0.24833055) < 1e-4);
    @assert(math.abs(genome_mlsnk._get_mls_selection_p(1) - 0.13854238) < 1e-4);
    @assert(math.abs(genome_mlsnk._get_mls_selection_p(2) - 0.07401712) < 1e-4);
    @assert(math.abs(genome_mlsnk._get_mls_selection_p(3) - 0.03096912) < 1e-4);
    @assert(math.abs(genome_mlsnk._get_mls_selection_p(4) - 0.01573537) < 1e-4);
    @assert(math.abs(genome_mlsnk._get_mls_selection_p(5) - 0.00793294) < 1e-4);
    @assert(math.abs(genome_mlsnk._get_mls_selection_p(6) - 0.00318918) < 1e-4);
    @assert(math.abs(genome_mlsnk._get_mls_selection_p(7) - 0.00159729) < 1e-4);
    for (@range(u16, 1, genome_mlsnk.nMlsSites, 1)) |i| {
        @assert(
            genome_mlsnk._get_mls_selection_p(i)
            < genome_mlsnk._get_mls_selection_p(i - 1)
        );
    }
}

fn test_mls_clobber_p() void {
    // default compconf: clobber scale 1.0
    @assert(genome_mlsnk._get_mls_clobber_p(0) == 1.0);
    @assert(genome_mlsnk._get_mls_clobber_p(1) == 0.5);
    @assert(genome_mlsnk._get_mls_clobber_p(2) == 0.25);
    @assert(math.abs(genome_mlsnk._get_mls_clobber_p(3) - 0.1) < 1e-6);
    @assert(math.abs(genome_mlsnk._get_mls_clobber_p(4) - 0.05) < 1e-6);
    @assert(math.abs(genome_mlsnk._get_mls_clobber_p(5) - 0.025) < 1e-6);
    @assert(math.abs(genome_mlsnk._get_mls_clobber_p(6) - 0.01) < 1e-6);
    @assert(math.abs(genome_mlsnk._get_mls_clobber_p(7) - 0.005) < 1e-6);
}

fn test_calc_nk_contribution() void {
    const K = genome_mlsnk.nkK;
    const N = genome_mlsnk.nkN;
    for (@range(u16, N)) |site| {
        for (@range(u16, 2)) |_| {
            const nkBits = @as(u32, @random16());
            const c = genome_mlsnk._calc_nk_contribution(site, nkBits);
            @assert(0.0 <= c and c < 1.0);
            // deterministic
            @assert(c == genome_mlsnk._calc_nk_contribution(site, nkBits));
            // upper bits beyond 16 NK sites are ignored
            @assert(
                c == genome_mlsnk._calc_nk_contribution(
                    site, nkBits | 0xFFFF0000
                )
            );

            for (@range(u16, N)) |j| {
                const flipped = nkBits ^ (@as(u32, 1) << @as(u32, j));
                const c_ = genome_mlsnk._calc_nk_contribution(site, flipped);
                // is j within site's wrapped neighborhood [site, site + K]?
                const offset = (j + N - site) % N;
                if (offset <= K) {
                    @assert(c != c_);
                } else {
                    @assert(c == c_);
                }
            }
        }
    }

    // different sites have different contributions for same neighborhood
    @assert(
        genome_mlsnk._calc_nk_contribution(0, 0)
        != genome_mlsnk._calc_nk_contribution(1, 0)
    );
}

fn test_nk_fitness_cache() void {
    random.set_global_prng_seed(1);

    var genome = @zeros(genome_mlsnk.genome_t);
    var genome_ptr = @ptrcast(genome_mlsnk.genomePtr_t, &genome[0]);
    genome_mlsnk.initialize_one(genome_ptr);
    @assert(
        genome_mlsnk._get_cached_nk_fitness(genome_ptr)
        == genome_mlsnk._calc_nk_fitness(genome_ptr)
    );

    // non-NK sites don't affect NK fitness
    const nkFit = genome_mlsnk._calc_nk_fitness(genome_ptr);
    genome[0] ^= 0x0000FFFF;
    @assert(genome_mlsnk._calc_nk_fitness(genome_ptr) == nkFit);
    genome[0] ^= 0x0000FFFF;

    // NK sites do affect NK fitness
    genome[0] ^= 0x00010000;
    @assert(genome_mlsnk._calc_nk_fitness(genome_ptr) != nkFit);
    genome[0] ^= 0x00010000;

    // cache stays consistent under heavy mutation
    var nNkChanges: u16 = 0;
    for (@range(u16, 32)) |_| {
        const before = genome[0];
        genome_mlsnk._elapse_inheritance_with(genome_ptr, 2);
        if (((before ^ genome[0]) & genome_mlsnk.nkMask) != 0) {
            nNkChanges += 1;
        }
        const cached = genome_mlsnk._get_cached_nk_fitness(genome_ptr);
        @assert(cached == genome_mlsnk._calc_nk_fitness(genome_ptr));
        @assert(0.0 <= cached and cached < 1.0);
    }
    @assert(nNkChanges > 16);
}

fn test_elapse_inheritance_of() void {
    var genome = @zeros(genome_mlsnk.genome_t);
    var genome_ptr = @ptrcast(genome_mlsnk.genomePtr_t, &genome[0]);

    // clear genomes are unaffected
    genome_mlsnk.elapse_inheritance_of(genome_ptr);
    for (@range(u16, genome_mlsnk.gSize)) |i| { @assert(genome[i] == 0); }

    genome_mlsnk.initialize_one(genome_ptr);
    @assert(genome[2] == 128);

    genome_mlsnk.elapse_inheritance_of(genome_ptr);
    @assert(genome[2] == 130);

    genome_mlsnk.elapse_inheritance_of(genome_ptr);
    @assert(genome[2] == 132);

    // sites, in both halves of word 0
    var genome0 = genome[0];
    while ((genome0 & 0xFFFF) == (genome[0] & 0xFFFF)) {
        genome_mlsnk._apply_mutation(genome_ptr, 8);
    }
    genome0 = genome[0];
    while ((genome0 >> 16) == (genome[0] >> 16)) {
        genome_mlsnk._apply_mutation(genome_ptr, 8);
    }

    // mutation does not touch cached fitness or counter words
    const genome1 = genome[1];
    const genome2 = genome[2];
    for (@range(u16, 64)) |_| { genome_mlsnk._apply_mutation(genome_ptr, 1); }
    @assert(genome[1] == genome1);
    @assert(genome[2] == genome2);

    // hstrat bitfield
    for (@range(u16, 3, 7, 1)) |i| {
        var genome_i = genome[i];
        while (genome_i == genome[i]) {
            genome_mlsnk.elapse_inheritance_of(genome_ptr);
        }
    }
}

fn test_calc_fitness_of() void {
    random.set_global_prng_seed(1);

    var genome = @zeros(genome_mlsnk.genome_t);
    var genome_ptr = @ptrcast(genome_mlsnk.genomePtr_t, &genome[0]);
    @assert(genome_mlsnk.calc_fitness_of(genome_ptr) == 0.0);

    genome_mlsnk.initialize_one(genome_ptr);
    const baseFit = 1.0 + genome_mlsnk._get_cached_nk_fitness(genome_ptr);
    @assert(1.0 <= baseFit and baseFit < 2.0);
    @assert(genome_mlsnk.calc_fitness_of(genome_ptr) == baseFit);

    // neutral sites have no effect
    genome[0] ^= genome_mlsnk.neutralMask;
    @assert(genome_mlsnk.calc_fitness_of(genome_ptr) == baseFit);
    genome[0] ^= genome_mlsnk.neutralMask;

    // NK sites affect fitness, if cache refreshed
    genome[0] ^= 0x00010000;
    genome_mlsnk._refresh_nk_fitness(genome_ptr);
    const nkFit = genome_mlsnk.calc_fitness_of(genome_ptr);
    @assert(nkFit != baseFit);
    @assert(1.0 <= nkFit and nkFit < 2.0);
    genome[0] ^= 0x00010000;
    genome_mlsnk._refresh_nk_fitness(genome_ptr);
    @assert(genome_mlsnk.calc_fitness_of(genome_ptr) == baseFit);

    // MLS sites stochastically add bonus, with expected probability
    const nTrials: u16 = 100;
    for (@range(u16, genome_mlsnk.nMlsSites)) |site| {
        genome[0] |= @as(u32, 1) << @as(u32, site);
        var nBonus: u16 = 0;
        for (@range(u16, nTrials)) |_| {
            const fit = genome_mlsnk.calc_fitness_of(genome_ptr);
            if (fit == baseFit + genome_mlsnk._mlsBonus) {
                nBonus += 1;
            } else {
                @assert(fit == baseFit);
            }
        }
        const expected = (
            genome_mlsnk._get_mls_selection_p(site) * @as(f32, nTrials)
        );
        // generous tolerance, at least ~5 standard deviations
        const tol = 0.25 * expected + 15.0;
        @assert(math.abs(@as(f32, nBonus) - expected) < tol);
        genome[0] &= ~(@as(u32, 1) << @as(u32, site));
    }
    @assert(genome_mlsnk.calc_fitness_of(genome_ptr) == baseFit);

    // multiple MLS sites stack
    genome[0] |= 0x03;
    const singleFit = baseFit + genome_mlsnk._mlsBonus;
    const doubleFit = singleFit + genome_mlsnk._mlsBonus;
    var sawDouble = false;
    while (!sawDouble) {
        const fit = genome_mlsnk.calc_fitness_of(genome_ptr);
        @assert(fit == baseFit or fit == singleFit or fit == doubleFit);
        sawDouble = fit == doubleFit;
    }
    genome[0] &= ~@as(u32, 0x03);

    genome_mlsnk._clear(genome_ptr);
    @assert(genome_mlsnk.calc_fitness_of(genome_ptr) == 0.0);
}

fn test_get_trait_value() void {
    var genome = @zeros(genome_mlsnk.genome_t);
    var genome_ptr = @ptrcast(genome_mlsnk.genomePtr_t, &genome[0]);
    @assert(genome_mlsnk.get_trait_value(genome_ptr) == 0);

    genome_mlsnk.initialize_one(genome_ptr);
    @assert(genome_mlsnk.get_trait_value(genome_ptr) == 1);

    // neutral and NK sites don't affect trait value
    genome[0] ^= 0xFFFFFF00;
    @assert(genome_mlsnk.get_trait_value(genome_ptr) == 1);
    genome[0] ^= 0xFFFFFF00;

    genome[0] |= 0x01;
    @assert(genome_mlsnk.get_trait_value(genome_ptr) == 2);
    genome[0] |= 0x80;
    @assert(genome_mlsnk.get_trait_value(genome_ptr) == 3);
    genome[0] |= 0xFF;
    @assert(genome_mlsnk.get_trait_value(genome_ptr) == 9);
    @assert(
        genome_mlsnk.get_trait_value(genome_ptr)
        < @as(u32, genome_mlsnk.nTraitVals)
    );

    genome_mlsnk._clear(genome_ptr);
    @assert(genome_mlsnk.get_trait_value(genome_ptr) == 0);
}

fn test_initialize_one() void {
    var genome = @zeros(genome_mlsnk.genome_t);
    var genome_ptr = @ptrcast(genome_mlsnk.genomePtr_t, &genome[0]);
    genome_mlsnk.initialize_one(genome_ptr);
    @assert(genome[0] == 0x0F00);
    @assert(
        genome_mlsnk._get_cached_nk_fitness(genome_ptr)
        == genome_mlsnk._calc_nk_fitness(genome_ptr)
    );
    @assert(genome[1] != 0);
    @assert(genome[2] == 128);
    @assert(genome[3] != 0);
    @assert(genome[4] != 0);
    @assert(genome[5] != 0);
    @assert(genome[6] != 0);
    @assert(genome[3] != genome[4]);
    @assert(genome[4] != genome[5]);
    @assert(genome[5] != genome[6]);
    @assert(genome[6] != genome[3]);
    @assert(!genome_mlsnk._is_clear(genome_ptr));
}

fn test_clobber_immigrant() void {
    random.set_global_prng_seed(1);

    var imm = @zeros(genome_mlsnk.genome_t);
    var imm_ptr = @ptrcast(genome_mlsnk.genomePtr_t, &imm[0]);

    var resident = @zeros(genome_mlsnk.genome_t);
    var resident_ptr = @ptrcast(genome_mlsnk.genomePtr_t, &resident[0]);
    genome_mlsnk.initialize_one(resident_ptr);

    // occupied resident always clobbers immigrant
    for (@range(u16, 0, 255, 8)) |i| {
        genome_mlsnk.initialize_one(imm_ptr);
        imm[0] |= @as(u32, i) & genome_mlsnk.mlsMask;
        @assert(genome_mlsnk.clobber_immigrant(resident_ptr, imm_ptr));
        @assert(genome_mlsnk._is_clear(imm_ptr));
        @assert(!genome_mlsnk._is_clear(resident_ptr));
    }

    var empty_resident = @zeros(genome_mlsnk.genome_t);
    var empty_resident_ptr = @ptrcast(
        genome_mlsnk.genomePtr_t, &empty_resident[0]
    );

    // empty resident, no MLS sites: never clobbers
    genome_mlsnk.initialize_one(imm_ptr);
    imm[0] ^= genome_mlsnk.neutralMask | genome_mlsnk.nkMask;
    for (@range(u16, 255)) |_| {
        @assert(!genome_mlsnk.clobber_immigrant(empty_resident_ptr, imm_ptr));
        @assert(!genome_mlsnk._is_clear(imm_ptr));
    }

    // empty resident, single MLS site: clobbers with expected probability
    var template = @zeros(genome_mlsnk.genome_t);
    var template_ptr = @ptrcast(genome_mlsnk.genomePtr_t, &template[0]);
    genome_mlsnk.initialize_one(template_ptr);
    const nTrials: u16 = 100;
    for (@range(u16, genome_mlsnk.nMlsSites)) |site| {
        var nClobber: u16 = 0;
        for (@range(u16, nTrials)) |_| {
            for (@range(u16, genome_mlsnk.gSize)) |w| { imm[w] = template[w]; }
            imm[0] |= @as(u32, 1) << @as(u32, site);
            const clobbered = genome_mlsnk.clobber_immigrant(
                empty_resident_ptr, imm_ptr
            );
            @assert(clobbered == genome_mlsnk._is_clear(imm_ptr));
            @assert(genome_mlsnk._is_clear(empty_resident_ptr));
            nClobber += @as(u16, clobbered);
        }
        const expected = (
            genome_mlsnk._get_mls_clobber_p(site) * @as(f32, nTrials)
        );
        const tol = 0.25 * expected + 15.0;
        @assert(math.abs(@as(f32, nClobber) - expected) < tol);
    }
    // site 0 has 100% clobber chance
    for (@range(u16, 32)) |_| {
        for (@range(u16, genome_mlsnk.gSize)) |w| { imm[w] = template[w]; }
        imm[0] |= 0x01;
        @assert(genome_mlsnk.clobber_immigrant(empty_resident_ptr, imm_ptr));
    }

    // empty immigrant onto empty resident: no clobber
    genome_mlsnk._clear(imm_ptr);
    @assert(!genome_mlsnk.clobber_immigrant(empty_resident_ptr, imm_ptr));
}

fn do_test() void {
    test_builtin_random_seeding();
    test_log2_u32();
    test_mls_selection_p();
    test_mls_clobber_p();
    test_calc_nk_contribution();
    test_nk_fitness_cache();
    test_elapse_inheritance_of();
    test_calc_fitness_of();
    test_get_trait_value();
    test_initialize_one();
    test_clobber_immigrant();
}
