const math = @import_module("<math>");
const random = @import_module("<random>");

const opscalar = @import_module("cerebraslib/opscalar.csl");

const genome = @import_module("cerebraslib/genome/genome_alleleevoepi_2026_11_21.csl");

fn _is_close(actual: f32, expected: f32) bool {
    return math.abs(actual - expected) < 1e-3 * expected;
}

/// Immunity countdown nibbles, full for each allele set in immunity bits.
fn _full_immunity(bits: u16) u16 {
    var immunity: u16 = 0;
    for (@range(u16, 2 * genome.nSites)) |j| {
        if (((bits >> j) & 1) != 0) {
            immunity |= genome._immunity_countdown_cap << (4 * j);
        }
    }
    return immunity;
}

/// Make genome with given pathogen sites, infection countdown, and immunity
/// countdown nibbles.
fn _make(g: *genome.genome_t, sites: u16, countdown: u16, immunity: u16) void {
    const f = genome._cast_fields(g);
    f.*.pathogen = sites | (countdown << genome.infectionShift);
    f.*.immunity = immunity;
}

/// Mask of enabled immunity bits, i.e., both alleles of each enabled site.
fn _enabled_immunity_mask() u16 {
    return genome._calc_allele_bits(0x00) | genome._calc_allele_bits(0xFF);
}

fn test_enabled_sites() void {
    @assert(genome.nSitesMax == 2);
    @assert(0 < genome.nSites and genome.nSites <= genome.nSitesMax);
    @assert(genome.sitesMask == (@as(u16, 1) << genome.nSites) - 1);
    // disabled sites are ignored: read as 0, and have no immunity bits
    var g = @zeros(genome.genome_t);
    _make(&g, 0xFF, 1, 0);
    @assert(genome._get_sites(&g) == genome.sitesMask);
    @assert(opscalar.popcnt32(@as(u32, _enabled_immunity_mask())) == 2 * genome.nSites);
    @assert(genome.get_trait_value(&g) == 1 | (@as(u32, genome.sitesMask) << 1));
    @assert(genome.nTraitVals == @as(u16, 1) << (genome.nSites + 1));
}

fn test_default_countdowns() void {
    @assert(genome._infection_countdown_cap == 10);
    @assert(genome._infection_countdown_p == 1.0);
    @assert(genome._immunity_countdown_cap == 15);
    @assert(_is_close(genome._immunity_countdown_p, 0.15));
}

fn test_immunity_bits() void {
    // bit 2 * i + a set iff nibble 2 * i + a is nonzero
    @assert(genome._get_immunity_bits(0x0000) == 0);
    @assert(genome._get_immunity_bits(0x0001) == 0x1);
    @assert(genome._get_immunity_bits(0x00F0) == 0x2);
    @assert(genome._get_immunity_bits(0x1000) == 0x8);
    @assert(genome._get_immunity_bits(0xFFFF) == _enabled_immunity_mask());
    @assert(genome._get_immunity_bits(_full_immunity(0x5)) == 0x5);
}

fn test_calc_allele_bits() void {
    // bit 2 * i + a marks allele a at enabled site i
    const enabled = _enabled_immunity_mask();
    @assert(genome._calc_allele_bits(0x00) == (0x5555 & enabled));
    @assert(genome._calc_allele_bits(0xFF) == (0xAAAA & enabled));
    @assert(genome._calc_allele_bits(0x01) == (0x5556 & enabled));
    @assert(genome._count_immune_alleles(0xFFFF, 0x5A) == genome.nSites);
    @assert(genome._count_immune_alleles(0x0000, 0x5A) == 0);
    @assert(genome._count_immune_alleles(0x5555, 0x00) == genome.nSites);
    // site 0 allele 1 and site 1 allele 0 only
    @assert(genome._count_immune_alleles(0x0006, 0x01) == 2);
}

fn test_tables() void {
    // default compconf: contact rate 0.35, immune strength 0.7
    const expectedTransmission = [3]f32{ 0.35, 0.105, 0.0315 };
    for (@range(u16, 3)) |k| {
        @assert(_is_close(genome._get_transmission_p(k), expectedTransmission[k]));
    }
    // default compconf: mutation rate 1e-6, within-host b 0.2, T 25
    @assert(_is_close(genome._get_mutation_p(0), 4.966310265e-06));
    @assert(_is_close(genome._get_mutation_p(1), 2.500031250e-05));
    @assert(_is_close(genome._get_mutation_p(2), 7.370657955e-04));
}

fn test_rtc_mutation_rate() void {
    // named runtime config overrides compconf mutation rate
    const default = genome.rtc_evoepi_mutationRate[0];
    @assert(_is_close(default, 1e-6));
    genome.rtc_evoepi_mutationRate[0] = 1e-3;
    @assert(_is_close(genome._get_mutation_p(2), 7.370657955e-01));
    genome.rtc_evoepi_mutationRate[0] = 1e-2;
    @assert(genome._get_mutation_p(2) == 1.0);
    genome.rtc_evoepi_mutationRate[0] = default;
}

fn test_initialize_one() void {
    // test layout is a single PE, at col 0, row 0, so it is seeded: infected
    // with wildtype pathogen, full infection countdown, no immunity
    var g = @zeros(genome.genome_t);
    for (@range(u16, 16)) |_| {
        g[0] = 0xFFFFFFFF;
        genome.initialize_one(&g);
        @assert(genome._is_infected(&g));
        @assert(genome._get_sites(&g) == 0);
        @assert(genome._get_infection_countdown(&g) == genome._infection_countdown_cap);
        @assert(genome._cast_fields(&g).*.immunity == 0);
    }
}

fn test_trample_resident() void {
    random.set_global_prng_seed(1);
    var resident = @zeros(genome.genome_t);
    var spawn = @zeros(genome.genome_t);
    const spawnSites = 0x02 & genome.sitesMask;

    // uninfected spawn never infects
    _make(&spawn, spawnSites, 0, 0x1234);
    for (@range(u16, 64)) |_| {
        _make(&resident, 0, 0, 0xF00F);
        genome.trample_resident(&resident, &spawn);
        @assert(resident[0] == (@as(u32, 0xF00F) << 16));
    }

    // infected resident is never reinfected, and keeps its countdown
    _make(&spawn, spawnSites, 3, 0x1234);
    for (@range(u16, 64)) |_| {
        _make(&resident, 0x01, 2, 0x0003);
        genome.trample_resident(&resident, &spawn);
        @assert(genome._get_sites(&resident) == (0x01 & genome.sitesMask));
        @assert(genome._get_infection_countdown(&resident) == 2);
    }

    // uninfected, nonimmune resident is infected at contact rate, gaining
    // spawn's sites and a full infection countdown, keeping own immunity
    const nTrials: u16 = 2000;
    var nInfected: u32 = 0;
    // immune only to alleles spawn doesn't carry
    const residentImmunity = _full_immunity(
        ~genome._calc_allele_bits(spawnSites) & _enabled_immunity_mask()
    );
    for (@range(u16, nTrials)) |_| {
        _make(&resident, 0, 0, residentImmunity);
        genome.trample_resident(&resident, &spawn);
        @assert(genome._cast_fields(&resident).*.immunity == residentImmunity);
        if (genome._is_infected(&resident)) {
            nInfected += 1;
            @assert(
                genome._get_infection_countdown(&resident)
                == genome._infection_countdown_cap
            );
        }
    }
    // expect 700, standard deviation ~21
    @assert(nInfected > 600 and nInfected < 800);

    // immunity (any nonzero countdown) to both of spawn's alleles reduces
    // infection to 0.35 * 0.3 ^ 2
    nInfected = 0;
    var partialImmunity: u16 = 0;
    for (@range(u16, 2 * genome.nSites)) |j| {
        if (((genome._calc_allele_bits(spawnSites) >> j) & 1) != 0) {
            partialImmunity |= @as(u16, 1) << (4 * j); // countdown at 1
        }
    }
    for (@range(u16, nTrials)) |_| {
        _make(&resident, 0, 0, partialImmunity);
        genome.trample_resident(&resident, &spawn);
        nInfected += @as(u32, genome._is_infected(&resident));
    }
    // expect 63, standard deviation ~7.8
    @assert(nInfected > 30 and nInfected < 100);
}

fn test_clobber_immigrant() void {
    random.set_global_prng_seed(1);
    var resident = @zeros(genome.genome_t);
    var immigrant = @zeros(genome.genome_t);
    var nInfects: u32 = 0;
    const nTrials: u16 = 2000;
    for (@range(u16, nTrials)) |_| {
        _make(&resident, 0, 0, 0x0000);
        _make(&immigrant, 0x03, 4, 0xFFFF);
        const clobbered = genome.clobber_immigrant(&resident, &immigrant);
        // immigrant always carries resident's immunity, never its own
        @assert(genome._cast_fields(&immigrant).*.immunity == 0x0000);
        if (clobbered) {
            @assert(immigrant[0] == resident[0]);
        } else {
            // infects: resident takes on pathogen, with full countdown
            @assert(
                genome._get_infection_countdown(&immigrant)
                == genome._infection_countdown_cap
            );
            nInfects += 1;
        }
    }
    // nonimmune resident: expect 0.35 * 2000 = 700 infections, sd ~21
    @assert(nInfects > 600 and nInfects < 800);

    // uninfected immigrant never infects, and is not counted as clobbered
    _make(&resident, 0x01, 5, 0x00F0);
    _make(&immigrant, 0, 0, 0xFFFF);
    @assert(!genome.clobber_immigrant(&resident, &immigrant));
    @assert(immigrant[0] == resident[0]);
}

fn test_recovery() void {
    random.set_global_prng_seed(1);
    var g = @zeros(genome.genome_t);
    const sites = 0x02 & genome.sitesMask;
    // default countdown step probability 1: infection lasts exactly cap
    // generations, then grants full immunity countdowns to carried alleles,
    // renewing any already partly counted down
    // site 0 allele 1, not carried: nibble 1, left as is
    const otherAllele: u16 = 0x0030;
    @assert((genome._calc_allele_bits(sites) & 0x2) == 0);
    _make(&g, sites, genome._infection_countdown_cap, otherAllele);
    for (@range(u16, genome._infection_countdown_cap - 1)) |i| {
        genome._apply_recovery(&g);
        @assert(genome._is_infected(&g));
        @assert(
            genome._get_infection_countdown(&g)
            == genome._infection_countdown_cap - 1 - i
        );
    }
    genome._apply_recovery(&g);
    @assert(!genome._is_infected(&g));
    @assert(genome._cast_fields(&g).*.pathogen == 0);
    @assert(
        genome._cast_fields(&g).*.immunity
        == (_full_immunity(genome._calc_allele_bits(sites)) | otherAllele)
    );

    // renewal: recovery resets a partly counted down allele to full
    _make(&g, 0, 1, 0x0001);
    genome._apply_recovery(&g);
    @assert(genome._cast_fields(&g).*.immunity == _full_immunity(genome._calc_allele_bits(0)));

    // uninfected hosts stay uninfected
    _make(&g, 0, 0, 0x8000);
    genome._apply_recovery(&g);
    @assert(g[0] == (@as(u32, 0x8000) << 16));
}

fn test_waning() void {
    random.set_global_prng_seed(1);
    var g = @zeros(genome.genome_t);
    // each nonzero countdown steps down w.p. 0.15 (default), never below 0
    var nSteps: u32 = 0;
    const nTrials: u16 = 1000;
    const full = _full_immunity(_enabled_immunity_mask());
    for (@range(u16, nTrials)) |_| {
        _make(&g, 0x03 & genome.sitesMask, 2, full);
        genome._apply_waning(&g);
        // waning never touches pathogen
        @assert(genome._get_infection_countdown(&g) == 2);
        const remaining = genome._cast_fields(&g).*.immunity;
        for (@range(u16, 2 * genome.nSites)) |j| {
            const nibble = (remaining >> (4 * j)) & 0xF;
            @assert(
                nibble == genome._immunity_countdown_cap
                or nibble == genome._immunity_countdown_cap - 1
            );
            nSteps += @as(u32, nibble != genome._immunity_countdown_cap);
        }
    }
    // expect 0.15 * 1000 * 4 = 600 steps (2 sites), sd ~23
    const expected = 0.15 * 1000.0 * 2.0 * @as(f32, genome.nSites);
    @assert(@as(f32, nSteps) > 0.85 * expected and @as(f32, nSteps) < 1.15 * expected);

    // countdown at 1 runs out, and zero countdowns stay zero
    var nLost: u32 = 0;
    for (@range(u16, nTrials)) |_| {
        _make(&g, 0, 0, 0x0001);
        genome._apply_waning(&g);
        nLost += @as(u32, genome._cast_fields(&g).*.immunity == 0);
        @assert((genome._cast_fields(&g).*.immunity & 0xFFF0) == 0);
    }
    @assert(nLost > 100 and nLost < 200);
    _make(&g, 0, 0, 0);
    genome._apply_waning(&g);
    @assert(g[0] == 0);
}

fn test_immunity_duration() void {
    // immunity lasts cap / p generations on average (100 by default)
    random.set_global_prng_seed(1);
    var g = @zeros(genome.genome_t);
    var total: u32 = 0;
    const nTrials: u16 = 200;
    for (@range(u16, nTrials)) |_| {
        _make(&g, 0, 0, genome._immunity_countdown_cap);
        var duration: u32 = 0;
        while (genome._cast_fields(&g).*.immunity != 0) {
            genome._apply_waning(&g);
            duration += 1;
        }
        total += duration;
    }
    // mean 100, per-trial sd ~24, so sd of mean ~1.7
    const mean = @as(f32, total) / @as(f32, nTrials);
    @assert(mean > 92.0 and mean < 108.0);
}

fn test_elapse_inheritance_of() void {
    random.set_global_prng_seed(1);
    var g = @zeros(genome.genome_t);
    // uninfected, nonimmune hosts are unchanged
    for (@range(u16, 16)) |_| {
        genome.elapse_inheritance_of(&g);
        @assert(g[0] == 0);
    }
    // infected host recovers after exactly cap generations (p 1)
    _make(&g, 0x00, genome._infection_countdown_cap, 0);
    var nGenerations: u16 = 0;
    while (genome._is_infected(&g) and nGenerations < 1000) {
        genome.elapse_inheritance_of(&g);
        nGenerations += 1;
    }
    @assert(nGenerations == genome._infection_countdown_cap);
    @assert(genome._get_immunity_bits(genome._cast_fields(&g).*.immunity) != 0);
}

fn test_calc_fitness_and_trait() void {
    var g = @zeros(genome.genome_t);
    // uninfected: trait value 0, regardless of immunity
    _make(&g, 0x00, 0, 0xFFFF);
    @assert(genome.calc_fitness_of(&g) == 0.0);
    @assert(genome.get_trait_value(&g) == 0);
    @assert(genome.is_empty(&g));  // uninfected hosts aren't sent by p2p
    // infected: bit 0 set, then bit 1 + i holds site i's allele
    _make(&g, 0x00, 1, 0);
    @assert(genome.calc_fitness_of(&g) == 1.0);
    @assert(genome.get_trait_value(&g) == 1);
    @assert(!genome.is_empty(&g));
    _make(&g, 0x01, 7, 0);
    @assert(genome.get_trait_value(&g) == 3);
    _make(&g, 0x02, 15, 0);
    @assert(genome.get_trait_value(&g) == 5);
    _make(&g, 0x03, 1, 0);
    @assert(genome.get_trait_value(&g) == 7);
    @assert(genome.get_trait_value(&g) < @as(u32, genome.nTraitVals));
}

fn test_is_empty() void {
    // messages under a word are zero padded, so all-zero messages must be
    // empty
    if (genome.gBitsMsg < 32) {
        var zeroMsg = @zeros(genome.genome_t);
        @assert(genome.is_empty(&zeroMsg));
    }
    var g = @zeros(genome.genome_t);
    _make(&g, 0x00, 0, _full_immunity(0x0F));
    @assert(genome.is_empty(&g));  // uninfected, even if immune
    _make(&g, 0x03, 1, 0);
    @assert(!genome.is_empty(&g));  // infected
}

fn do_test() void {
    test_is_empty();
    test_enabled_sites();
    test_default_countdowns();
    test_immunity_bits();
    test_calc_allele_bits();
    test_tables();
    test_rtc_mutation_rate();
    test_initialize_one();
    test_trample_resident();
    test_clobber_immigrant();
    test_recovery();
    test_waning();
    test_immunity_duration();
    test_elapse_inheritance_of();
    test_calc_fitness_and_trait();
}
