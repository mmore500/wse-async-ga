const genome = @import_module("cerebraslib/genome/genome_purifyingstripped.csl");

fn test_elapse_inheritance_of() void {
    var g = @zeros(genome.genome_t);
    genome.elapse_inheritance_of(&g);
}

fn test_calc_fitness_of() void {
    var g = @zeros(genome.genome_t);
    @assert(genome.calc_fitness_of(&g) == 0.0);
}

fn test_get_trait_value() void {
    var g = @zeros(genome.genome_t);
    @assert(genome.get_trait_value(&g) == 0);
    @assert(genome.get_trait_value(&g) < @as(u32, genome.nTraitVals));
}

fn test_initialize_one() void {
    var g = @zeros(genome.genome_t);
    genome.initialize_one(&g);
}

fn test_trample_resident() void {
    var resident = @zeros(genome.genome_t);
    var spawn = @zeros(genome.genome_t);
    for (@range(u16, genome.gSize)) |i| {
        spawn[i] = 0x01234567 ^ (@as(u32, i) << 8);
        resident[i] = ~spawn[i];
    }
    genome.trample_resident(
        @ptrcast([*]u32, &resident), @ptrcast([*]u32, &spawn)
    );
    for (@range(u16, genome.gSize)) |i| {
        @assert(resident[i] == spawn[i]);
        @assert(spawn[i] == 0x01234567 ^ (@as(u32, i) << 8));
    }
}

fn test_fields_layout() void {
    // memory layout struct fields sit at their documented byte offsets,
    // and together exactly cover the genome
    var g = @zeros(genome.genome_t);
    const f = genome._cast_fields(&g);
    {
        const field_bytes = @ptrcast([*]u8, &f.*.fitness);
        for (@range(u16, 4)) |k| { field_bytes[k] = @as(u8, 1 + k); }
    }
    const genome_bytes = @ptrcast([*]u8, &g);
    for (@range(u16, 4 * genome.gSize)) |i| {
        @assert(genome_bytes[i] == @as(u8, i + 1));
    }
}

fn do_test() void {
    test_fields_layout();
    test_calc_fitness_of();
    test_elapse_inheritance_of();
    test_get_trait_value();
    test_initialize_one();
    test_trample_resident();
}
