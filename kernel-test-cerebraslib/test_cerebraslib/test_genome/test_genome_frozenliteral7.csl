const genome_frozenliteral7 = @import_module("cerebraslib/genome/genome_frozenliteral7.csl");

fn test_elapse_inheritance_of() void {
    var genome = @zeros(genome_frozenliteral7.genome_t);
    genome_frozenliteral7.initialize_one(&genome);
    genome_frozenliteral7.elapse_inheritance_of(&genome);
    @assert(genome_frozenliteral7._validate(&genome));
}

fn test_calc_fitness_of() void {
    var genome = @zeros(genome_frozenliteral7.genome_t);
    genome_frozenliteral7.initialize_one(&genome);
    @assert(genome_frozenliteral7.calc_fitness_of(&genome) == 0.0);
}

fn test_get_trait_value() void {
    var g = @zeros(genome_frozenliteral7.genome_t);
    @assert(genome_frozenliteral7.get_trait_value(&g) == 0);
    @assert(
        genome_frozenliteral7.get_trait_value(&g)
        < @as(u32, genome_frozenliteral7.nTraitVals)
    );
}

fn test_initialize_one() void {
    var genome = @zeros(genome_frozenliteral7.genome_t);
    genome_frozenliteral7.initialize_one(&genome);
    @assert(genome_frozenliteral7._validate(&genome));
}

fn test_trample_resident() void {
    var resident = @zeros(genome_frozenliteral7.genome_t);
    var spawn = @zeros(genome_frozenliteral7.genome_t);
    for (@range(u16, genome_frozenliteral7.gWordsPop)) |i| {
        spawn[i] = 0x01234567 ^ (@as(u32, i) << 8);
        resident[i] = ~spawn[i];
    }
    genome_frozenliteral7.trample_resident(
        @ptrcast([*]u32, &resident), @ptrcast([*]u32, &spawn)
    );
    for (@range(u16, genome_frozenliteral7.gWordsPop)) |i| {
        @assert(resident[i] == spawn[i]);
        @assert(spawn[i] == 0x01234567 ^ (@as(u32, i) << 8));
    }
}

fn test_is_empty() void {
    // messages under a word are zero padded, so all-zero messages must be
    // empty
    if (genome_frozenliteral7.gBitsMsg < 32) {
        var zeroMsg = @zeros(genome_frozenliteral7.genome_t);
        @assert(genome_frozenliteral7.is_empty(&zeroMsg));
    }
    var g = @zeros(genome_frozenliteral7.genome_t);
    @assert(!genome_frozenliteral7.is_empty(&g));
    genome_frozenliteral7.initialize_one(&g);
    @assert(!genome_frozenliteral7.is_empty(&g));
}

fn do_test() void {
    test_is_empty();
    test_calc_fitness_of();
    test_elapse_inheritance_of();
    test_get_trait_value();
    test_initialize_one();
    test_trample_resident();
}
