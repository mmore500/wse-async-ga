const genome = @import_module("cerebraslib/genome/genome_bitdrift.csl");
const population = @import_module("cerebraslib/population_tournamentsteadystate.csl", .{
    .genome = genome,
    .popSize = 100,
    .tournamentSize = 3.0,
    .pExtinction = 0.0,
});

const genomeFrozen = @import_module(
    "cerebraslib/genome/genome_frozenliteral3.csl",
);
const populationExtinction = @import_module("cerebraslib/population_tournamentsteadystate.csl", .{
    .genome = genomeFrozen,
    .popSize = 2,
    .tournamentSize = 3.0,
    .pExtinction = 1.0,
});

const genomeClobber = @import_module(
    "cerebraslib/genome/genome_bitdrift_clobber.csl",
);
const populationClobber = @import_module("cerebraslib/population_tournamentsteadystate.csl", .{
    .genome = genomeClobber,
    .popSize = 2,
    .tournamentSize = 3.0,
    .pExtinction = 1.0,
});

// internal accessors ======================================================
fn test_calc_ith_fitness() void {
    population._calc_ith_fitness(0);
}

fn test_elapse_ith_inheritance() void {
    population._elapse_ith_inheritance(0);
}

fn test_get_ith_genome() void {
    population._get_ith_genome(0);
}

fn test_get_ith_trait_value() void {
    population._get_ith_trait_value(0);
}

fn test_get_population_word() void {
    population._get_population_word(0);
}

fn test_sample_one_tournament() void {
    population._sample_one_tournament();
    var i: f32 = 1.1;
    @assert(@as(i32, i) == 1);
    i = 1.9;
    @assert(@as(i32, i) == 1);
    i = 2.1;
    @assert(@as(i32, i) == 2);
}

// internal routines ==========================================================
fn test_elapse_inheritance_all() void {
    population._elapse_inheritance_all();
}

fn test_perform_selection_all() void {
    population._perform_selection_all();
}

fn test_perform_extinction_all() void {
    populationExtinction.init_module();
    @assert(populationExtinction._get_population_word(0) != 0);
    @assert(populationExtinction._get_population_word(1) != 0);
    @assert(populationExtinction._get_population_word(2) != 0);
    @assert(populationExtinction._get_population_word(3) != 0);
    @assert(populationExtinction._get_population_word(4) != 0);
    @assert(populationExtinction._get_population_word(5) != 0);
    populationExtinction._perform_extinction_all();
    @assert(populationExtinction._get_population_word(0) == 0);
    @assert(populationExtinction._get_population_word(1) == 0);
    @assert(populationExtinction._get_population_word(2) == 0);
    @assert(populationExtinction._get_population_word(3) == 0);
    @assert(populationExtinction._get_population_word(4) == 0);
    @assert(populationExtinction._get_population_word(5) == 0);
}

// public API =================================================================
fn test_emigrate_genomes() void {
    population.emigrate_genomes(population.bufferDsd, 10);
}

fn test_immigrate_genomes() void {
    population.immigrate_genomes(@ptrcast([*]u32, &population.buffer), 10);
}

fn test_immigrate_genomes_clobber() void {
    populationClobber.immigrate_genomes(@ptrcast([*]u32, &populationClobber.buffer), 2);
}

fn _count_matching_slots(
    imm: [*]u32, buf: [*]u32, nSlots: u16, gSize: u16,
) u16 {
    var n: u16 = 0;
    for (@range(u16, nSlots)) |s| {
        var isMatch = true;
        for (@range(u16, gSize)) |w| {
            if (buf[s * gSize + w] != imm[w]) isMatch = false;
        }
        n += @as(u16, isMatch);
    }
    return n;
}

fn test_immigrate_genomes_overwrites_random_members() void {
    const gSize = genome.gSize;
    const popSize: u16 = 100;
    const nImm: u16 = 4;

    // snapshot population, and build distinct marker immigrants
    var before = @zeros([popSize * gSize]u32);
    for (@range(u16, popSize * gSize)) |w| { before[w] = population.buffer[w]; }
    var imm = @zeros([nImm * gSize]u32);
    for (@range(u16, nImm)) |i| {
        for (@range(u16, gSize)) |w| {
            imm[i * gSize + w] = 0xABC00000 + @as(u32, i) * 16 + @as(u32, w);
        }
    }

    const nClobbers = population.immigrate_genomes(@ptrcast([*]u32, &imm), nImm);
    @assert(nClobbers == 0);  // genome_bitdrift has no clobber hook

    // every slot either is unchanged or holds exactly one immigrant
    var nChanged: u16 = 0;
    var nImmSlots: u16 = 0;
    for (@range(u16, popSize)) |s| {
        var isSame = true;
        for (@range(u16, gSize)) |w| {
            if (population.buffer[s * gSize + w] != before[s * gSize + w]) {
                isSame = false;
            }
        }
        nChanged += @as(u16, !isSame);
    }
    for (@range(u16, nImm)) |i| {
        nImmSlots += _count_matching_slots(
            @ptrcast([*]u32, &imm[i * gSize]),
            @ptrcast([*]u32, &population.buffer),
            popSize,
            gSize,
        );
    }
    @assert(1 <= nChanged and nChanged <= nImm);
    @assert(nImmSlots == nChanged);

    // the last immigrant can't be overwritten by a later one
    @assert(_count_matching_slots(
        @ptrcast([*]u32, &imm[(nImm - 1) * gSize]),
        @ptrcast([*]u32, &population.buffer),
        popSize,
        gSize,
    ) == 1);
}

fn test_immigrate_genomes_clobber_count() void {
    // living residents clobber (zero out) every incoming immigrant
    populationClobber.init_module();
    var imm = @zeros([2 * genomeClobber.gSize]u32);
    for (@range(u16, 2 * genomeClobber.gSize)) |w| { imm[w] = 0x5A5A0000 + @as(u32, w); }
    const nClobbers = populationClobber.immigrate_genomes(
        @ptrcast([*]u32, &imm), 2
    );
    @assert(nClobbers == 2);
    for (@range(u16, 2 * genomeClobber.gSize)) |w| { @assert(imm[w] == 0); }
}

fn test_do_generation() void {
    population.do_generation();
}

// test runner ================================================================
fn do_test() void {
    population.init_module();
    test_calc_ith_fitness();
    test_elapse_ith_inheritance();
    test_get_ith_genome();
    test_get_ith_trait_value();
    test_get_population_word();
    test_sample_one_tournament();
    test_elapse_inheritance_all();
    test_perform_selection_all();
    test_perform_extinction_all();
    test_emigrate_genomes();
    test_immigrate_genomes();
    test_immigrate_genomes_clobber();
    test_immigrate_genomes_overwrites_random_members();
    test_immigrate_genomes_clobber_count();
    test_do_generation();
}
