// populations of a genome with messages smaller than the genome: the
// allele-evoepi genome sends only its pathogen (low half-word)
const genome = @import_module(
    "cerebraslib/genome/genome_alleleevoepi_2026_11_19.csl"
);
const generational = @import_module(
    "cerebraslib/population_tournamentgenerational.csl",
    .{ .genome = genome, .popSize = 8, .pExtinction = 0.0,
       .tournamentSize = 1.0 },
);
const steadystate = @import_module(
    "cerebraslib/population_tournamentsteadystate.csl",
    .{ .genome = genome, .popSize = 8, .pExtinction = 0.0,
       .tournamentSize = 1.0 },
);

const nMsg: u16 = 4;
var msgBuf = @zeros([2 + 1]u32);  // 4 half-word messages, and a guard word

fn _fields(g: [*]u32) *genome.fields_t { return genome._cast_fields(g); }

fn _ith(pop: [*]u32, i: u16) *genome.fields_t {
    return _fields(@ptrcast([*]u32, &pop[i]));
}

// each host i has distinct immunity, and is infected with pathogen sites i.
// (genomes are 1 word, so host i is pop[i])
fn _setup(pop: [*]u32) void {
    for (@range(u16, 8)) |i| {
        _ith(pop, i).*.pathogen = i | genome.infectedFlag;
        _ith(pop, i).*.immunity = 0x0100 * (i + 1);
    }
}

// each host's immunity is still there, though hosts may be permuted
fn _check_immunity_kept(pop: [*]u32) void {
    for (@range(u16, 8)) |j| {
        var count: u16 = 0;
        for (@range(u16, 8)) |i| {
            if (_ith(pop, i).*.immunity == 0x0100 * (j + 1)) { count += 1; }
        }
        @assert(count == 1);
    }
}

// every sent message is some host's pathogen, and nothing else is written
fn _check_emigrated(pop: [*]u32) void {
    @assert(msgBuf[2] == 0xFEEDBEEF);
    for (@range(u16, nMsg)) |k| {
        const msg: u16 = @as(u16, (msgBuf[k / 2] >> (16 * (k % 2))) & 0xFFFF);
        var found = false;
        for (@range(u16, 8)) |i| {
            if (_ith(pop, i).*.pathogen == msg) { found = true; }
        }
        @assert(found);
    }
}

fn _fill_messages() void {
    // uninfected immigrants never infect, so leave residents as they were
    msgBuf[0] = 0; msgBuf[1] = 0; msgBuf[2] = 0xFEEDBEEF;
}

fn test_message_size() void {
    @assert(genome.gBitsMsg == 16);
    @assert(generational.migration.message.words_for(nMsg) == 2);
}

fn test_generational() void {
    _setup(@ptrcast([*]u32, &generational.buffer));
    msgBuf[2] = 0xFEEDBEEF;
    generational.emigrate_genomes(@ptrcast([*]u32, &msgBuf), nMsg);
    _check_emigrated(@ptrcast([*]u32, &generational.buffer));

    _fill_messages();
    const nClobbers = generational.immigrate_genomes(
        @ptrcast([*]u32, &msgBuf), nMsg
    );
    @assert(nClobbers == 0);
    _check_immunity_kept(@ptrcast([*]u32, &generational.buffer));
    for (@range(u16, 8)) |i| {  // uninfected immigrants infect no one
        const f = _fields(generational._get_ith_genome(i));
        @assert(f.*.pathogen == (i | genome.infectedFlag));
    }

    // infected immigrants replace pathogens only, never immunity
    msgBuf[0] = 0x01000100 | 0x00010001; msgBuf[1] = msgBuf[0];
    const n = generational.immigrate_genomes(@ptrcast([*]u32, &msgBuf), nMsg);
    @assert(n <= nMsg);
    _check_immunity_kept(@ptrcast([*]u32, &generational.buffer));
}

fn test_steadystate() void {
    _setup(@ptrcast([*]u32, &steadystate.buffer));
    msgBuf[2] = 0xFEEDBEEF;
    steadystate.emigrate_genomes(@ptrcast([*]u32, &msgBuf), nMsg);
    _check_emigrated(@ptrcast([*]u32, &steadystate.buffer));

    _fill_messages();
    const nClobbers = steadystate.immigrate_genomes(
        @ptrcast([*]u32, &msgBuf), nMsg
    );
    @assert(nClobbers == 0);
    _check_immunity_kept(@ptrcast([*]u32, &steadystate.buffer));

    msgBuf[0] = 0x01000100 | 0x00010001; msgBuf[1] = msgBuf[0];
    const n = steadystate.immigrate_genomes(@ptrcast([*]u32, &msgBuf), nMsg);
    @assert(n <= nMsg);
    _check_immunity_kept(@ptrcast([*]u32, &steadystate.buffer));
}

// set host i infected with pathogen sites i if (mask >> i) & 1, else not
fn _infect_masked(pop: [*]u32, mask: u16) void {
    for (@range(u16, 8)) |i| {
        const isInfected = ((mask >> i) & 1) == 1;
        _ith(pop, i).*.pathogen = (
            if (isInfected) (i | genome.infectedFlag) else 0
        );
    }
}

// messages are live hosts' pathogens; batch padding past count is zero
fn _check_live_batch(pop: [*]u32, count: u16, mask: u16) void {
    for (@range(u16, 4)) |k| {
        const msg = @as(u16, (msgBuf[k / 2] >> (16 * (k % 2))) & 0xFFFF);
        if (k < count) {
            @assert((msg & genome.infectedFlag) != 0);
            const site = msg & 0xFF;
            @assert(((mask >> site) & 1) == 1);  // from a live host
        } else {
            @assert(msg == 0);
        }
    }
    @assert(msgBuf[2] == 0xFEEDBEEF);
}

fn _emigrate_live(which: u16) u16 {  // 0: generational, 1: steady state
    const toBuf = @ptrcast([*]u32, &msgBuf);
    if (which == 0) { return generational.emigrate_live_genomes(toBuf, nMsg); }
    return steadystate.emigrate_live_genomes(toBuf, nMsg);
}

fn _test_emigrate_live(pop: [*]u32, which: u16) void {
    _setup(pop);
    msgBuf[2] = 0xFEEDBEEF;
    // all live: full batch of consecutive (wrapping) hosts
    var count = _emigrate_live(which);
    @assert(count == nMsg);
    _check_live_batch(pop, count, 0xFF);

    // none live: nothing sent
    _infect_masked(pop, 0x00);
    count = _emigrate_live(which);
    @assert(count == 0);
    _check_live_batch(pop, count, 0x00);

    // two live: nothing if sampled host is empty, else short batch of both
    _infect_masked(pop, 0x24);
    var nSent: u16 = 0;
    for (@range(u16, 64)) |rep| {
        count = _emigrate_live(which);
        @assert(count == 0 or count == 2);
        _check_live_batch(pop, count, 0x24);
        if (count == 2) { nSent += 1; }
    }
    @assert(0 < nSent and nSent < 64);  // sent about 1 in 4 times
}

fn _emigrate_batch(which: u16) u16 {  // 0: generational, 1: steady state
    const toBuf = @ptrcast([*]u32, &msgBuf);
    if (which == 0) { return generational.emigrate_live_batch(toBuf, nMsg); }
    return steadystate.emigrate_live_batch(toBuf, nMsg);
}

// count messages in a full batch that are live hosts' pathogens
fn _count_live_messages(mask: u16) u16 {
    var nLive: u16 = 0;
    for (@range(u16, nMsg)) |k| {
        const msg = @as(u16, (msgBuf[k / 2] >> (16 * (k % 2))) & 0xFFFF);
        if ((msg & genome.infectedFlag) != 0) {
            @assert(((mask >> (msg & 0xFF)) & 1) == 1);  // from a live host
            nLive += 1;
        } else {
            @assert(msg == 0);  // empty hosts here are all-zero pathogen
        }
    }
    @assert(msgBuf[2] == 0xFEEDBEEF);
    return nLive;
}

fn _test_emigrate_batch(pop: [*]u32, which: u16) void {
    _setup(pop);
    msgBuf[2] = 0xFEEDBEEF;
    // all live: full batch, no empty genomes passed over
    @assert(_emigrate_batch(which) == 0);
    @assert(_count_live_messages(0xFF) == nMsg);

    // none live: whole population passed over, batch of empty genomes
    _infect_masked(pop, 0x00);
    @assert(_emigrate_batch(which) == 8);
    @assert(_count_live_messages(0x00) == 0);

    // two live: both sent, rest of batch empty, all 6 empty passed over
    _infect_masked(pop, 0x24);
    @assert(_emigrate_batch(which) == 6);
    @assert(_count_live_messages(0x24) == 2);

    // six live: full batch, passing over between 0 and 2 empty genomes
    _infect_masked(pop, 0x7E);
    for (@range(u16, 16)) |rep| {
        @assert(_emigrate_batch(which) <= 2);
        @assert(_count_live_messages(0x7E) == nMsg);
    }
}

fn test_emigrate_live_batch() void {
    _test_emigrate_batch(@ptrcast([*]u32, &generational.buffer), 0);
    _test_emigrate_batch(@ptrcast([*]u32, &steadystate.buffer), 1);
}

fn test_emigrate_live_genomes() void {
    _test_emigrate_live(@ptrcast([*]u32, &generational.buffer), 0);
    _test_emigrate_live(@ptrcast([*]u32, &steadystate.buffer), 1);
}

fn do_test() void {
    test_message_size();
    test_generational();
    test_steadystate();
    test_emigrate_live_genomes();
    test_emigrate_live_batch();
}
