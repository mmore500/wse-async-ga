const math = @import_module("<math>");
const random = @import_module("<random>");

const opscalar = @import_module("cerebraslib/opscalar.csl");
const opaque = @import_module("cerebraslib/opaque.csl");


fn test_add32() void {
    @assert(opscalar.add32(0, 0) == 0);
    @assert(opscalar.add32(0, 1) == 1);
    @assert(opscalar.add32(1, 0) == 1);
    @assert(opscalar.add32(1, 1) == 2);
    @assert(opscalar.add32(1, 2) == 3);
    @assert(opscalar.add32(138, 4) == 142);
    @assert(opscalar.add32(138, 0) == 138);
}

fn test_as() void {
    var val = @as(u32, 65536);
    @assert(0 == @as(u16, val));
}

var out = [1]u16{0};
const out_dsd = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{1} -> out[0] });
fn test_clz() void {
    @clz(out_dsd, 0);
    @assert(out[0] == 16);
}

fn test_clz32() void {
    @assert(opscalar.clz32(0xFFFFFFFF) == 0);
    @assert(opscalar.clz32(0xF0FFFFFF) == 0);
    @assert(opscalar.clz32(0x80FFFFFF) == 0);
    @assert(opscalar.clz32(0x80000000) == 0);
    @assert(opscalar.clz32(0x70FFFFFF) == 1);
    @assert(opscalar.clz32(0x70FFFF00) == 1);
    @assert(opscalar.clz32(0x3AAAAAAA) == 2);
    @assert(opscalar.clz32(0x0FAAAAAA) == 4);
    @assert(opscalar.clz32(0x0008F588) == 12);
    @assert(opscalar.clz32(0x0007F585) == 13);
    @assert(opscalar.clz32(0x0001F587) == 15);
    @assert(opscalar.clz32(0x00008881) == 16);
    @assert(opscalar.clz32(0x00005881) == 17);
    @assert(opscalar.clz32(3) == 30);
    @assert(opscalar.clz32(2) == 30);
    @assert(opscalar.clz32(1) == 31);
    @assert(opscalar.clz32(0) == 32);
}

fn test_ctz() void {
    @ctz(out_dsd, 0);
    @assert(out[0] == 16);
}

fn test_ctz32() void {
    @assert(opscalar.ctz32(0) == 32);
    @assert(opscalar.ctz32(1) == 0);
    @assert(opscalar.ctz32(2) == 1);
    @assert(opscalar.ctz32(3) == 0);
    @assert(opscalar.ctz32(32768) == 15);
    @assert(opscalar.ctz32(65534) == 1);
    @assert(opscalar.ctz32(65535) == 0);
    @assert(opscalar.ctz32(65536) == 16);
    @assert(opscalar.ctz32(65537) == 0);
    @assert(opscalar.ctz32(65538) == 1);
}


fn test_incr16() void {
    @assert(opscalar.incr16(0) == 1);
    @assert(opscalar.incr16(1) == 2);
    @assert(opscalar.incr16(2) == 3);
    @assert(opscalar.incr16(3) == 4);
    @assert(opscalar.incr16(32768) == 32769);
    @assert(opscalar.incr16(65534) == 65535);
}


fn test_incr32() void {
    @assert(opscalar.incr32(0) == 1);
    @assert(opscalar.incr32(1) == 2);
    @assert(opscalar.incr32(2) == 3);
    @assert(opscalar.incr32(3) == 4);
    @assert(opscalar.incr32(32768) == 32769);
    @assert(opscalar.incr32(65534) == 65535);
    @assert(opscalar.incr32(65535) == 65536);
    @assert(opscalar.incr32(65536) == 65537);
    @assert(opscalar.incr32(65537) == 65538);
    @assert(opscalar.incr32(65538) == 65539);
}

fn test_incrmod32() void {
    @assert(opscalar.incrmod32(0, 0) == 0);
    @assert(opscalar.incrmod32(0, 1) == 0);
    @assert(opscalar.incrmod32(0, 2) == 1);
    @assert(opscalar.incrmod32(1, 2) == 0);
    @assert(opscalar.incrmod32(0, 3) == 1);
    @assert(opscalar.incrmod32(1, 3) == 2);
    @assert(opscalar.incrmod32(2, 3) == 0);
}

fn test_addmod16() void {
    @assert(opscalar.addmod16(0, 0, 1) == 0);
    @assert(opscalar.addmod16(2, 3, 7) == 5);
    @assert(opscalar.addmod16(5, 3, 7) == 1);
    @assert(opscalar.addmod16(6, 6, 7) == 5);
    @assert(opscalar.addmod16(65535, 65535, 65535) == 0);  // no u16 overflow
    @assert(opscalar.addmod16(65534, 3, 65535) == 2);
}

fn test_divceil16() void {
    @assert(opscalar.divceil16(0, 32) == 0);
    @assert(opscalar.divceil16(1, 32) == 1);
    @assert(opscalar.divceil16(32, 32) == 1);
    @assert(opscalar.divceil16(33, 32) == 2);
    @assert(opscalar.divceil16(7, 1) == 7);
    @assert(opscalar.divceil16(65535, 65535) == 1);  // no u16 overflow
}

fn test_mul32() void {
    @assert(opscalar.mul32(0, 0) == 0);
    @assert(opscalar.mul32(0, 1) == 0);
    @assert(opscalar.mul32(1, 0) == 0);
    @assert(opscalar.mul32(1, 1) == 1);
    @assert(opscalar.mul32(1, 2) == 2);
    @assert(opscalar.mul32(3, 2) == 6);
    @assert(opscalar.mul32(138, 4) == 552);
    @assert(opscalar.mul32(138, 0) == 0);
}

fn test_clamp() void {
    @assert(opscalar.clamp(@as(f32, 0.5), 0.0, 1.0) == 0.5);
    @assert(opscalar.clamp(@as(f32, -2.0), 0.0, 1.0) == 0.0);
    @assert(opscalar.clamp(@as(f32, 3.0), 0.0, 1.0) == 1.0);
    @assert(opscalar.clamp(@as(f32, 0.0), 0.0, 1.0) == 0.0);
    @assert(opscalar.clamp(@as(f32, 1.0), 0.0, 1.0) == 1.0);
    const nan = @bitcast(f32, @as(u32, 0x7FC00000));
    @assert(math.isNaN(opscalar.clamp(nan, 0.0, 1.0)));
    @assert(math.isNaN(opscalar.clamp(-nan, 0.0, 1.0)));
    @assert(opscalar.clamp(@as(u32, 7), 2, 5) == 5);
    @assert(opscalar.clamp(@as(u32, 1), 2, 5) == 2);
    @assert(opscalar.clamp(@as(u32, 3), 2, 5) == 3);
}

fn test_clamp_nanmin() void {
    @assert(opscalar.clamp_nanmin(@as(f32, 0.5), 0.0, 1.0) == 0.5);
    @assert(opscalar.clamp_nanmin(@as(f32, -2.0), 0.0, 1.0) == 0.0);
    @assert(opscalar.clamp_nanmin(@as(f32, 3.0), 0.0, 1.0) == 1.0);
    @assert(opscalar.clamp_nanmin(@as(f32, 0.0), 0.0, 1.0) == 0.0);
    @assert(opscalar.clamp_nanmin(@as(f32, 1.0), 0.0, 1.0) == 1.0);
    const nan = @bitcast(f32, @as(u32, 0x7FC00000));
    @assert(opscalar.clamp_nanmin(nan, 0.0, 1.0) == 0.0);
    @assert(opscalar.clamp_nanmin(nan, -1.0, 1.0) == -1.0);
    @assert(opscalar.clamp_nanmin(-nan, 0.0, 1.0) == 0.0);
    @assert(opscalar.clamp_nanmin(@as(u32, 7), 2, 5) == 5);
    @assert(opscalar.clamp_nanmin(@as(u32, 1), 2, 5) == 2);
    @assert(opscalar.clamp_nanmin(@as(u32, 3), 2, 5) == 3);
}

fn test_clamp_nanmax() void {
    @assert(opscalar.clamp_nanmax(@as(f32, 0.5), 0.0, 1.0) == 0.5);
    @assert(opscalar.clamp_nanmax(@as(f32, -2.0), 0.0, 1.0) == 0.0);
    @assert(opscalar.clamp_nanmax(@as(f32, 3.0), 0.0, 1.0) == 1.0);
    @assert(opscalar.clamp_nanmax(@as(f32, 0.0), 0.0, 1.0) == 0.0);
    @assert(opscalar.clamp_nanmax(@as(f32, 1.0), 0.0, 1.0) == 1.0);
    const nan = @bitcast(f32, @as(u32, 0x7FC00000));
    @assert(opscalar.clamp_nanmax(nan, 0.0, 1.0) == 1.0);
    @assert(opscalar.clamp_nanmax(nan, -1.0, 2.0) == 2.0);
    @assert(opscalar.clamp_nanmax(-nan, 0.0, 1.0) == 1.0);
    @assert(opscalar.clamp_nanmax(@as(u32, 7), 2, 5) == 5);
    @assert(opscalar.clamp_nanmax(@as(u32, 1), 2, 5) == 2);
    @assert(opscalar.clamp_nanmax(@as(u32, 3), 2, 5) == 3);
}

fn test_p() void {
    for (@range(u16, 20)) |i| { @assert(opscalar.p(1.0)); }
    for (@range(u16, 20)) |i| { @assert(!opscalar.p(0.0)); }
    while (!opscalar.p(0.5)) {}
    while (opscalar.p(0.5)) {}

    random.set_global_prng_seed(1);
    var count: u32 = 0;
    for (@range(u16, 400)) |i| { count += @as(u32, opscalar.p(0.25)); }
    @assert(count > 60 and count < 140);
}

fn test_p_threshold32_runtime() void {
    @assert(opscalar._p_threshold32(opaque.opaque_f32(0.75)) == 0xC0000000);
    @assert(opscalar._p_threshold32(opaque.opaque_f32(0.5)) == 0x80000000);
    @assert(opscalar._p_threshold32(opaque.opaque_f32(0.9999999403953552)) == 0xFFFFFF00);
    @assert(opscalar._p_threshold32(opaque.opaque_f32(0.9996529221534729)) == 0xFFE94100);
    @assert(opscalar._p_threshold32(opaque.opaque_f32(0.25)) == 0x40000000);
    @assert(opscalar._p_threshold32(opaque.opaque_f32(2.3283064365386963e-10)) == 0x00000001);
    @assert(opscalar._p_threshold32(opaque.opaque_f32(0.6000000238418579)) == 0x99999A00);
    @assert(opscalar._p_threshold32(opaque.opaque_f32(0.8999999761581421)) == 0xE6666600);
}

fn test_p_threshold32() void {
    // 2^-32 resolution: small powers of two are exact, not rounded up
    @assert(opscalar._p_threshold32(0.0) == 0);
    @assert(opscalar._p_threshold32(0.5) == 0x80000000);
    @assert(opscalar._p_threshold32(0.25) == 0x40000000);
    @assert(opscalar._p_threshold32(1.0 / 8388608.0) == 512); // 2^-23
    @assert(opscalar._p_threshold32(1.0 / 16777216.0) == 256); // 2^-24
    @assert(opscalar._p_threshold32(1.0 / 67108864.0) == 64); // 2^-26
    @assert(opscalar._p_threshold32(1.0 / 268435456.0) == 16); // 2^-28
    @assert(opscalar._p_threshold32(1.0 / 4294967296.0) == 1); // 2^-32
    @assert(opscalar._p_threshold32(1e-6) == 4294); // floor(4294.97)
}

fn test_random_u32() void {
    random.set_global_prng_seed(1);
    const first = opscalar.random_u32();
    var anyHigh = false;
    var anyOdd = false;
    var anyEven = false;
    var anyDiff = false;
    for (@range(u16, 20)) |i| {
        const x = opscalar.random_u32();
        anyHigh = anyHigh or x >= 0x10000;
        anyOdd = anyOdd or (x & 1) != 0;
        anyEven = anyEven or (x & 1) == 0;
        anyDiff = anyDiff or x != first;
    }
    @assert(anyHigh and anyOdd and anyEven and anyDiff);
}

fn test_p_one_in() void {
    random.set_global_prng_seed(1);
    var count: u16 = 0;
    for (@range(u16, 20)) |i| {
        @assert(opscalar.p_one_in(1));
        if (opscalar.p_one_in(2)) { count += 1; }
    }
    @assert(count > 0 and count < 20);
}

fn test_poisson32() void {
    random.set_global_prng_seed(1);
    @assert(opscalar.poisson32(0.0) == 0);
    for (@range(u16, 100)) |i| { @assert(opscalar.poisson32(1.0) < 10); }
    for (@range(u16, 100)) |i| { @assert(opscalar.poisson32(0.5) < 5); }
    while (opscalar.poisson32(10.0) == opscalar.poisson32(10.0)) {}
    while (opscalar.poisson32(10.0) < 10) {}
    while (opscalar.poisson32(10.0) > 10) {}
    while (opscalar.poisson32(10.0) != 10) {}
    while (opscalar.poisson32(5.0) < 5) {}
    while (opscalar.poisson32(5.0) > 5) {}
    while (opscalar.poisson32(5.0) != 5) {}
    while (opscalar.poisson32(1.0) < 1) {}
    while (opscalar.poisson32(1.0) > 1) {}
    while (opscalar.poisson32(1.0) != 1) {}

    var sum_large: u32 = 0;
    var sum_small: u32 = 0;
    for (@range(u16, 10000)) |i| {
        sum_large += opscalar.poisson32(0.0001);
        sum_small += opscalar.poisson32(0.000001);
    }
    @assert(sum_large >= sum_small);
    @assert(sum_large < 5);
    @assert(sum_small < 2);
    while (opscalar.poisson32(0.0001) == 0) {
        @assert(opscalar.poisson32(0.000001) == 0);
    }
}

fn test_parity32() void {
    // zero has even parity
    @assert(!opscalar.parity32(0));

    // single bit set: odd parity
    @assert(opscalar.parity32(1));
    @assert(opscalar.parity32(2));
    @assert(opscalar.parity32(0x80000000));

    // two bits set: even parity
    @assert(!opscalar.parity32(3));
    @assert(!opscalar.parity32(5));
    @assert(!opscalar.parity32(0x80000001));

    // three bits set: odd parity
    @assert(opscalar.parity32(7));
    @assert(opscalar.parity32(0x80080010));

    // all bits set (32 = even): even parity
    @assert(!opscalar.parity32(0xFFFFFFFF));

    // 0xFF = 8 bits set (even)
    @assert(!opscalar.parity32(0xFF));

    // 0xFE = 7 bits set (odd)
    @assert(opscalar.parity32(0xFE));

    // alternating bits: 16 set (even)
    @assert(!opscalar.parity32(0x55555555));
    @assert(!opscalar.parity32(0xAAAAAAAA));
}

fn test_popcnt32() void {
    @assert(opscalar.popcnt32(0xFFFFFFFF) == 32);
    @assert(opscalar.popcnt32(0xF0FFFFFF) == 28);
    @assert(opscalar.popcnt32(0x80FFFFFF) == 25);
    @assert(opscalar.popcnt32(0x80000000) == 1);
    @assert(opscalar.popcnt32(0x80080000) == 2);
    @assert(opscalar.popcnt32(0x80080010) == 3);
    @assert(opscalar.popcnt32(0x80080030) == 4);
    @assert(opscalar.popcnt32(3) == 2);
    @assert(opscalar.popcnt32(2) == 1);
    @assert(opscalar.popcnt32(1) == 1);
    @assert(opscalar.popcnt32(0) == 0);
}

fn test_hamming_syndrome32() void {
    // zero: no bits set, syndrome is 0
    @assert(opscalar.hamming_syndrome32(0) == 0);

    // single bit set: syndrome equals the 1-indexed position
    @assert(opscalar.hamming_syndrome32(1) == 1); // bit 0 -> pos 1
    @assert(opscalar.hamming_syndrome32(2) == 2); // bit 1 -> pos 2
    @assert(opscalar.hamming_syndrome32(4) == 3); // bit 2 -> pos 3
    @assert(opscalar.hamming_syndrome32(8) == 4); // bit 3 -> pos 4
    @assert(opscalar.hamming_syndrome32(0x10) == 5); // bit 4 -> pos 5
    @assert(opscalar.hamming_syndrome32(0x20) == 6); // bit 5 -> pos 6
    @assert(opscalar.hamming_syndrome32(0x40) == 7); // bit 6 -> pos 7
    @assert(opscalar.hamming_syndrome32(0x80) == 8); // bit 7 -> pos 8
    @assert(opscalar.hamming_syndrome32(0x8000) == 16); // bit 15 -> pos 16
    @assert(opscalar.hamming_syndrome32(0x10000) == 17); // bit 16 -> pos 17
    @assert(opscalar.hamming_syndrome32(0x80000000) == 32); // bit 31 -> pos 32

    // two bits set: syndrome is XOR of their positions
    @assert(opscalar.hamming_syndrome32(3) == 3); // pos 1 XOR 2 = 3
    @assert(opscalar.hamming_syndrome32(5) == 2); // pos 1 XOR 3 = 2
    @assert(opscalar.hamming_syndrome32(6) == 1); // pos 2 XOR 3 = 1
    @assert(opscalar.hamming_syndrome32(0xA) == 6); // pos 2 XOR 4 = 6

    // all bits set: XOR of 1..32 = 32 (since 32 % 4 == 0)
    @assert(opscalar.hamming_syndrome32(0xFFFFFFFF) == 32);

    // all low byte bits: XOR of 1..8 = 8 (since 8 % 4 == 0)
    @assert(opscalar.hamming_syndrome32(0xFF) == 8);

    // all low 16 bits: XOR of 1..16 = 16 (since 16 % 4 == 0)
    @assert(opscalar.hamming_syndrome32(0xFFFF) == 16);

    // powers of two (Hamming weight 1) -- syndrome = position
    @assert(opscalar.hamming_syndrome32(0x100) == 9);
    @assert(opscalar.hamming_syndrome32(0x200) == 10);
    @assert(opscalar.hamming_syndrome32(0x40000000) == 31);

    // specific multi-bit patterns
    // pos 1 XOR 4 = 5
    @assert(opscalar.hamming_syndrome32(0x9) == 5);
    // pos 1 XOR 2 XOR 3 = 0
    @assert(opscalar.hamming_syndrome32(0x7) == 0);
    // pos 5 XOR 6 = 3
    @assert(opscalar.hamming_syndrome32(0x30) == 3);

    // flipping any single bit must change the syndrome
    const base: u32 = 0xA5A5A5A5;
    const base_syn = opscalar.hamming_syndrome32(base);
    for (@range(u32, 32)) |bit| {
        const flipped = base ^ (@as(u32, 1) << bit);
        @assert(opscalar.hamming_syndrome32(flipped) != base_syn);
    }

    // flipping two distinct bits must change the syndrome
    // (since flipping bits i,j changes syndrome by (i+1) XOR (j+1) != 0)
    const base2: u32 = 0x12345678;
    const base2_syn = opscalar.hamming_syndrome32(base2);
    // bit pair (0, 1)
    @assert(opscalar.hamming_syndrome32(base2 ^ 0x3) != base2_syn);
    // bit pair (4, 7)
    @assert(opscalar.hamming_syndrome32(base2 ^ 0x90) != base2_syn);
    // bit pair (15, 16)
    @assert(opscalar.hamming_syndrome32(base2 ^ 0x18000) != base2_syn);
    // bit pair (0, 31)
    @assert(opscalar.hamming_syndrome32(base2 ^ 0x80000001) != base2_syn);
    // bit pair (10, 20)
    @assert(opscalar.hamming_syndrome32(base2 ^ 0x100400) != base2_syn);
    // bit pair (3, 29)
    @assert(opscalar.hamming_syndrome32(base2 ^ 0x20000008) != base2_syn);
    // bit pair (6, 22)
    @assert(opscalar.hamming_syndrome32(base2 ^ 0x400040) != base2_syn);
    // bit pair (9, 13)
    @assert(opscalar.hamming_syndrome32(base2 ^ 0x2200) != base2_syn);
    // bit pair (2, 25)
    @assert(opscalar.hamming_syndrome32(base2 ^ 0x2000004) != base2_syn);
    // bit pair (18, 27)
    @assert(opscalar.hamming_syndrome32(base2 ^ 0x8040000) != base2_syn);
    // bit pair (11, 24)
    @assert(opscalar.hamming_syndrome32(base2 ^ 0x1000800) != base2_syn);
    // bit pair (5, 19)
    @assert(opscalar.hamming_syndrome32(base2 ^ 0x80020) != base2_syn);
}

fn test_unif16() void {
    @assert(opscalar.unif16(0) == 0);
    @assert(opscalar.unif16(1) == 0);
    for (@range(u16, 20)) |i| { @assert(opscalar.unif16(2) < 2); }
    for (@range(u16, 20)) |i| { @assert(opscalar.unif16(3) < 3); }
    random.set_global_prng_seed(1);
    @assert(opscalar.unif16(10000) != opscalar.unif16(10000));
}


fn test_unifbool() void {
    while (opscalar.unifbool()) {}
    while (!opscalar.unifbool()) {}
}


// === bitcast sanity =========================================================

fn test_bitcast_f32() void {
    @assert(@bitcast(u32, @as(f32, 0.0)) == 0x00000000);
    @assert(@bitcast(u32, @as(f32, 1.0)) == 0x3F800000);
    @assert(@bitcast(u32, @as(f32, -1.0)) == 0xBF800000);
    @assert(@bitcast(u32, @as(f32, 2.0)) == 0x40000000);
    @assert(@bitcast(f32, @as(u32, 0x3F800000)) == 1.0);
    @assert(@bitcast(f32, @as(u32, 0x40000000)) == 2.0);
}

fn test_bitcast_f16() void {
    @assert(@bitcast(u16, @as(f16, 0.0)) == 0x0000);
    @assert(@bitcast(u16, @as(f16, 1.0)) == 0x3C00);
    @assert(@bitcast(u16, @as(f16, -1.0)) == 0xBC00);
    @assert(@bitcast(f16, @as(u16, 0x3C00)) == @as(f16, 1.0));
}

// === nextf32 ================================================================

fn test_nextf32_pos_zero() void {
    @assert(@bitcast(u32, opscalar.nextf32(0.0, 1)) == 0x00000001);
}

fn test_nextf32_neg_zero() void {
    @assert(@bitcast(u32, opscalar.nextf32(@bitcast(f32, @as(u32, 0x80000000)), 1)) == 0x00000001);
}

fn test_nextf32_one() void {
    @assert(@bitcast(u32, opscalar.nextf32(1.0, 1)) == 0x3F800001);
}

fn test_nextf32_neg_one() void {
    // -1.0 = 0xBF800000, next toward +inf = 0xBF7FFFFF
    @assert(@bitcast(u32, opscalar.nextf32(-1.0, 1)) == 0xBF7FFFFF);
}

fn test_nextf32_two() void {
    @assert(@bitcast(u32, opscalar.nextf32(2.0, 1)) == 0x40000001);
}

fn test_nextf32_max_to_inf() void {
    // max finite -> +Inf
    @assert(@bitcast(u32, opscalar.nextf32(@bitcast(f32, @as(u32, 0x7F7FFFFF)), 1)) == 0x7F800000);
}

fn test_nextf32_pos_inf() void {
    // +Inf -> +Inf (fixed point)
    @assert(@bitcast(u32, opscalar.nextf32(@bitcast(f32, @as(u32, 0x7F800000)), 1)) == 0x7F800000);
}

fn test_nextf32_neg_inf() void {
    // -Inf -> -max finite
    @assert(@bitcast(u32, opscalar.nextf32(@bitcast(f32, @as(u32, 0xFF800000)), 1)) == 0xFF7FFFFF);
}

fn test_nextf32_neg_denorm_to_neg_zero() void {
    // -smallest denormal -> -0.0
    @assert(@bitcast(u32, opscalar.nextf32(@bitcast(f32, @as(u32, 0x80000001)), 1)) == 0x80000000);
}

fn test_nextf32_smallest_denorm() void {
    // smallest denormal -> next denormal
    @assert(@bitcast(u32, opscalar.nextf32(@bitcast(f32, @as(u32, 0x00000001)), 1)) == 0x00000002);
}

fn test_nextf32_nan() void {
    // NaN -> NaN (preserved)
    const nan_bits: u32 = 0x7FC00000;
    @assert(@bitcast(u32, opscalar.nextf32(@bitcast(f32, nan_bits), 1)) == nan_bits);
}

// === prevf32 ================================================================

fn test_prevf32_pos_zero() void {
    @assert(@bitcast(u32, opscalar.prevf32(0.0, 1)) == 0x80000001);
}

fn test_prevf32_neg_zero() void {
    @assert(@bitcast(u32, opscalar.prevf32(@bitcast(f32, @as(u32, 0x80000000)), 1)) == 0x80000001);
}

fn test_prevf32_one() void {
    @assert(@bitcast(u32, opscalar.prevf32(1.0, 1)) == 0x3F7FFFFF);
}

fn test_prevf32_neg_one() void {
    // -1.0 = 0xBF800000, prev toward -inf = 0xBF800001
    @assert(@bitcast(u32, opscalar.prevf32(-1.0, 1)) == 0xBF800001);
}

fn test_prevf32_neg_max_to_neg_inf() void {
    // -max finite -> -Inf
    @assert(@bitcast(u32, opscalar.prevf32(@bitcast(f32, @as(u32, 0xFF7FFFFF)), 1)) == 0xFF800000);
}

fn test_prevf32_neg_inf() void {
    // -Inf -> -Inf (fixed point)
    @assert(@bitcast(u32, opscalar.prevf32(@bitcast(f32, @as(u32, 0xFF800000)), 1)) == 0xFF800000);
}

fn test_prevf32_pos_inf() void {
    // +Inf -> max finite
    @assert(@bitcast(u32, opscalar.prevf32(@bitcast(f32, @as(u32, 0x7F800000)), 1)) == 0x7F7FFFFF);
}

fn test_prevf32_smallest_denorm_to_zero() void {
    // smallest denormal -> +0.0
    @assert(@bitcast(u32, opscalar.prevf32(@bitcast(f32, @as(u32, 0x00000001)), 1)) == 0x00000000);
}

fn test_prevf32_nan() void {
    const nan_bits: u32 = 0x7FC00000;
    @assert(@bitcast(u32, opscalar.prevf32(@bitcast(f32, nan_bits), 1)) == nan_bits);
}

// === nextf32/prevf32 roundtrips =============================================

fn test_f32_roundtrip() void {
    @assert(opscalar.prevf32(opscalar.nextf32(1.0, 1), 1) == 1.0);
    @assert(opscalar.nextf32(opscalar.prevf32(1.0, 1), 1) == 1.0);
    @assert(opscalar.prevf32(opscalar.nextf32(-1.0, 1), 1) == -1.0);
    @assert(opscalar.nextf32(opscalar.prevf32(-1.0, 1), 1) == -1.0);
    @assert(opscalar.prevf32(opscalar.nextf32(2.0, 1), 1) == 2.0);
}

// === nextf32/prevf32 ordering ===============================================

fn test_f32_ordering() void {
    @assert(opscalar.nextf32(1.0, 1) > 1.0);
    @assert(opscalar.prevf32(1.0, 1) < 1.0);
    @assert(opscalar.nextf32(-1.0, 1) > -1.0);
    @assert(opscalar.prevf32(-1.0, 1) < -1.0);
    @assert(opscalar.nextf32(0.0, 1) > 0.0);
    @assert(opscalar.prevf32(0.0, 1) < 0.0);
}

// === nextf32/prevf32 multi-step =============================================

fn test_nextf32_n_zero() void {
    @assert(opscalar.nextf32(1.0, 0) == 1.0);
    @assert(opscalar.nextf32(-1.0, 0) == -1.0);
}

fn test_nextf32_n_multi_pos() void {
    // 1.0 = 0x3F800000, +3 steps = 0x3F800003
    @assert(@bitcast(u32, opscalar.nextf32(1.0, 3)) == 0x3F800003);
    // 0.0 +5 steps = 0x00000005
    @assert(@bitcast(u32, opscalar.nextf32(0.0, 5)) == 0x00000005);
}

fn test_nextf32_n_zero_crossing() void {
    // -2nd denorm (0x80000002), +5: mag=2, remaining=3 -> 0x00000003
    @assert(@bitcast(u32, opscalar.nextf32(@bitcast(f32, @as(u32, 0x80000002)), 5)) == 0x00000003);
}

fn test_nextf32_n_saturate() void {
    // max finite +2 -> +Inf (room=1)
    @assert(@bitcast(u32, opscalar.nextf32(@bitcast(f32, @as(u32, 0x7F7FFFFF)), 2)) == 0x7F800000);
}

fn test_prevf32_n_zero() void {
    @assert(opscalar.prevf32(1.0, 0) == 1.0);
    @assert(opscalar.prevf32(-1.0, 0) == -1.0);
}

fn test_prevf32_n_multi_neg() void {
    // -1.0 = 0xBF800000, -3 steps = 0xBF800003
    @assert(@bitcast(u32, opscalar.prevf32(-1.0, 3)) == 0xBF800003);
    // 0.0 -5 steps = 0x80000005
    @assert(@bitcast(u32, opscalar.prevf32(0.0, 5)) == 0x80000005);
}

fn test_prevf32_n_zero_crossing() void {
    // 2nd denorm (0x00000002), -5: mag=2, remaining=3 -> 0x80000003
    @assert(@bitcast(u32, opscalar.prevf32(@bitcast(f32, @as(u32, 0x00000002)), 5)) == 0x80000003);
}

fn test_prevf32_n_saturate() void {
    // -max finite -2 -> -Inf (room=1)
    @assert(@bitcast(u32, opscalar.prevf32(@bitcast(f32, @as(u32, 0xFF7FFFFF)), 2)) == 0xFF800000);
}

fn test_f32_roundtrip_n() void {
    @assert(opscalar.prevf32(opscalar.nextf32(1.0, 5), 5) == 1.0);
    @assert(opscalar.nextf32(opscalar.prevf32(1.0, 5), 5) == 1.0);
    @assert(opscalar.prevf32(opscalar.nextf32(-1.0, 5), 5) == -1.0);
    @assert(opscalar.nextf32(opscalar.prevf32(-1.0, 5), 5) == -1.0);
}

// === nextf16 ================================================================

fn test_nextf16_pos_zero() void {
    @assert(@bitcast(u16, opscalar.nextf16(@as(f16, 0.0), 1)) == 0x0001);
}

fn test_nextf16_neg_zero() void {
    @assert(@bitcast(u16, opscalar.nextf16(@bitcast(f16, @as(u16, 0x8000)), 1)) == 0x0001);
}

fn test_nextf16_one() void {
    @assert(@bitcast(u16, opscalar.nextf16(@as(f16, 1.0), 1)) == 0x3C01);
}

fn test_nextf16_neg_one() void {
    @assert(@bitcast(u16, opscalar.nextf16(@as(f16, -1.0), 1)) == 0xBBFF);
}

fn test_nextf16_max_to_inf() void {
    @assert(@bitcast(u16, opscalar.nextf16(@bitcast(f16, @as(u16, 0x7BFF)), 1)) == 0x7C00);
}

fn test_nextf16_pos_inf() void {
    @assert(@bitcast(u16, opscalar.nextf16(@bitcast(f16, @as(u16, 0x7C00)), 1)) == 0x7C00);
}

fn test_nextf16_neg_inf() void {
    @assert(@bitcast(u16, opscalar.nextf16(@bitcast(f16, @as(u16, 0xFC00)), 1)) == 0xFBFF);
}

fn test_nextf16_nan() void {
    const nan_bits: u16 = 0x7E00;
    @assert(@bitcast(u16, opscalar.nextf16(@bitcast(f16, nan_bits), 1)) == nan_bits);
}

// === prevf16 ================================================================

fn test_prevf16_pos_zero() void {
    @assert(@bitcast(u16, opscalar.prevf16(@as(f16, 0.0), 1)) == 0x8001);
}

fn test_prevf16_neg_zero() void {
    @assert(@bitcast(u16, opscalar.prevf16(@bitcast(f16, @as(u16, 0x8000)), 1)) == 0x8001);
}

fn test_prevf16_one() void {
    @assert(@bitcast(u16, opscalar.prevf16(@as(f16, 1.0), 1)) == 0x3BFF);
}

fn test_prevf16_neg_one() void {
    @assert(@bitcast(u16, opscalar.prevf16(@as(f16, -1.0), 1)) == 0xBC01);
}

fn test_prevf16_neg_max_to_neg_inf() void {
    @assert(@bitcast(u16, opscalar.prevf16(@bitcast(f16, @as(u16, 0xFBFF)), 1)) == 0xFC00);
}

fn test_prevf16_neg_inf() void {
    @assert(@bitcast(u16, opscalar.prevf16(@bitcast(f16, @as(u16, 0xFC00)), 1)) == 0xFC00);
}

fn test_prevf16_pos_inf() void {
    @assert(@bitcast(u16, opscalar.prevf16(@bitcast(f16, @as(u16, 0x7C00)), 1)) == 0x7BFF);
}

fn test_prevf16_nan() void {
    const nan_bits: u16 = 0x7E00;
    @assert(@bitcast(u16, opscalar.prevf16(@bitcast(f16, nan_bits), 1)) == nan_bits);
}

// === nextf16/prevf16 roundtrips =============================================

fn test_f16_roundtrip() void {
    @assert(opscalar.prevf16(opscalar.nextf16(@as(f16, 1.0), 1), 1) == @as(f16, 1.0));
    @assert(opscalar.nextf16(opscalar.prevf16(@as(f16, 1.0), 1), 1) == @as(f16, 1.0));
    @assert(opscalar.prevf16(opscalar.nextf16(@as(f16, -1.0), 1), 1) == @as(f16, -1.0));
    @assert(opscalar.nextf16(opscalar.prevf16(@as(f16, -1.0), 1), 1) == @as(f16, -1.0));
}

// === nextf16/prevf16 ordering ===============================================

fn test_f16_ordering() void {
    @assert(opscalar.nextf16(@as(f16, 1.0), 1) > @as(f16, 1.0));
    @assert(opscalar.prevf16(@as(f16, 1.0), 1) < @as(f16, 1.0));
    @assert(opscalar.nextf16(@as(f16, -1.0), 1) > @as(f16, -1.0));
    @assert(opscalar.prevf16(@as(f16, -1.0), 1) < @as(f16, -1.0));
}

// === nextf16/prevf16 multi-step =============================================

fn test_nextf16_n_multi() void {
    @assert(opscalar.nextf16(@as(f16, 1.0), 0) == @as(f16, 1.0));
    // 1.0 = 0x3C00, +3 = 0x3C03
    @assert(@bitcast(u16, opscalar.nextf16(@as(f16, 1.0), 3)) == 0x3C03);
    @assert(@bitcast(u16, opscalar.nextf16(@as(f16, 0.0), 5)) == 0x0005);
}

fn test_prevf16_n_multi() void {
    @assert(opscalar.prevf16(@as(f16, 1.0), 0) == @as(f16, 1.0));
    // 1.0 = 0x3C00, -3 = 0x3BFD
    @assert(@bitcast(u16, opscalar.prevf16(@as(f16, 1.0), 3)) == 0x3BFD);
    @assert(@bitcast(u16, opscalar.prevf16(@as(f16, 0.0), 5)) == 0x8005);
}

fn test_f16_roundtrip_n() void {
    @assert(opscalar.prevf16(opscalar.nextf16(@as(f16, 1.0), 5), 5) == @as(f16, 1.0));
    @assert(opscalar.nextf16(opscalar.prevf16(@as(f16, 1.0), 5), 5) == @as(f16, 1.0));
}

