"""Runtime config ${name}, from runtime_config_template/default.py.in.

Reads kernel parameters as JSON from stdin, and writes an npz file of data
for symbols to stdout; see runtime_config.md.
"""

import json
import sys

import numpy as np

if __name__ == "__main__":
    params = json.load(sys.stdin)
    params.update(${overrides})  # from jsonl
    print(f"runtime config ${name} {params=}", file=sys.stderr)

    nRow, nCol = params["nRow"], params["nCol"]
    shape = (nRow, nCol, 1)
    np.savez(
        sys.stdout.buffer,
        whoami=np.arange(nRow * nCol, dtype=np.uint32).reshape(shape),
        whereami_x=np.indices((nRow, nCol), np.uint32)[1].reshape(shape),
        whereami_y=np.indices((nRow, nCol), np.uint32)[0].reshape(shape),
        globalSeed=np.full(shape, params["globalSeed"], dtype=np.uint32),
        nRowSubgrid=np.full(shape, params["nRowSubgrid"], dtype=np.uint32),
        nColSubgrid=np.full(shape, params["nColSubgrid"], dtype=np.uint32),
    )
