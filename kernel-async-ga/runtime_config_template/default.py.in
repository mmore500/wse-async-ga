"""Runtime config ${dispatch_slug}, from runtime_config_template/default.py.in.

Reads comptime configs as JSON from stdin, and writes an npz file of per-PE
values for rtc_* device symbols to stdout.
"""

import json
import sys

import numpy as np

if __name__ == "__main__":
    comptime_config = json.load(sys.stdin)
    runtime_config = ${runtime_config}  # from jsonl
    print("dispatch_slug ${dispatch_slug}", file=sys.stderr)
    print(f"{comptime_config=}", file=sys.stderr)
    print(f"{runtime_config=}", file=sys.stderr)

    shape = (comptime_config["nRow"], comptime_config["nCol"], 1)
    np.savez(
        sys.stdout.buffer,
        rtc_globalSeed=np.full(
            shape,
            runtime_config.get("globalSeed", comptime_config["globalSeed"]),
            np.uint32,
        ),
        rtc_nRowSubgrid=np.full(
            shape,
            runtime_config.get("nRowSubgrid", comptime_config["nRowSubgrid"]),
            np.uint32,
        ),
        rtc_nColSubgrid=np.full(
            shape,
            runtime_config.get("nColSubgrid", comptime_config["nColSubgrid"]),
            np.uint32,
        ),
        rtc_nCycleAtLeast=np.full(
            shape,
            runtime_config.get("nCycleAtLeast", comptime_config["nCycleAtLeast"]),
            np.uint32,
        ),
    )
