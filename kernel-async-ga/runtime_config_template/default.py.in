"""Runtime config ${name}, from runtime_config_template/default.py.in.

Reads comptime configs as JSON from stdin, and writes an npz file of per-PE
values for rtc_* device symbols to stdout.
"""

import json
import sys

import numpy as np

if __name__ == "__main__":
    comptime = json.load(sys.stdin)
    comptime.update(${overrides})  # from jsonl
    print(f"runtime config ${name} {comptime=}", file=sys.stderr)

    nRow, nCol = comptime["nRow"], comptime["nCol"]
    shape = (nRow, nCol, 1)
    np.savez(
        sys.stdout.buffer,
        rtc_whoami=np.arange(nRow * nCol, dtype=np.uint32).reshape(shape),
        rtc_whereami_x=np.indices((nRow, nCol), np.uint32)[1].reshape(shape),
        rtc_whereami_y=np.indices((nRow, nCol), np.uint32)[0].reshape(shape),
        rtc_globalSeed=np.full(shape, comptime["globalSeed"], np.uint32),
        rtc_nRowSubgrid=np.full(shape, comptime["nRowSubgrid"], np.uint32),
        rtc_nColSubgrid=np.full(shape, comptime["nColSubgrid"], np.uint32),
        rtc_nCycleAtLeast=np.full(shape, comptime["nCycleAtLeast"], np.uint32),
    )
