"""Runtime config ${dispatch_slug}, from runtime_config_template/default.py.in.

Reads comptime configs as JSON from stdin, and writes an npz file of per-PE
values for rtc_* device symbols to stdout.

See `runtime_config_options.md`.
"""

import json
import sys

import numpy as np
import polars as pl


def _check_symbol_values(*, symbolValues: dict, shape: tuple) -> str:
    """Check device symbol values are rtc_ symbols of 32-bit values of symbol
    shape, returning an error message if not (empty if ok)."""
    for symbol, value in sorted(symbolValues.items()):
        if not symbol.startswith("rtc_"):
            return f"{symbol=} invalid"
        if value.shape != shape or value.dtype.itemsize != 4:
            return f"{symbol=} needs 32-bit {shape=}"
    return ""


def _eval_symbol_values(*, exprs: dict, shape: tuple) -> dict:
    """Evaluate device symbol values from Python lambdas of symbol shape, e.g.,
    {"rtc_foo": "lambda shape: np.zeros(shape, np.int32)"}, as raw word bits.
    """
    symbolValues = {
        symbol: eval(expr, {"np": np, "shape": shape})(shape)
        for symbol, expr in exprs.items()
    }
    if error := _check_symbol_values(symbolValues=symbolValues, shape=shape):
        raise ValueError(f"setSymbolValues {error}")
    return {symbol: v.view(np.uint32) for symbol, v in symbolValues.items()}


def _nest_subgrid_sizes(
    *,
    nRow: int,
    nCol: int,
    nRowSubgrid: int,
    nColSubgrid: int,
    nestingFactor: int,
    nestingLevelPeriod: int,
    nestingLevelSplit: int = 0,
) -> tuple:
    """Per-PE subgrid sizes, nested outward from PE (0, 0) by nestingFactor.

    Nested subgrids, e.g., nestingFactor 2, with b = nRowSubgrid:
    +---+---+-------+---------------+
    | b | b |       |               |
    +---+---+  2b   |               |
    | b | b |       |               |
    +---+---+-------+      4b       |
    |       |       |               |
    |  2b   |  2b   |               |
    |       |       |               |
    +-------+-------+---------------+
    |               |               |
    |               |               |
    |               |               |
    |      4b       |      4b       |
    |               |               |
    |               |               |
    |               |               |
    +---------------+---------------+
    PE (0, 0) at top left; subgrids may overhang PE array.

    If nestingLevelPeriod L > 0, the first L levels repeat as tiles, e.g.,
    L 2:
    +---+---+-------+---+---+-------+
    | b | b |       | b | b |       |
    +---+---+  2b   +---+---+  2b   |
    | b | b |       | b | b |       |
    +---+---+-------+---+---+-------+
    |       |       |       |       |
    |  2b   |  2b   |  2b   |  2b   |
    |       |       |       |       |
    +-------+-------+-------+-------+

    If nestingLevelSplit S > 0, each subgrid is split into subgrids S levels
    smaller (but no smaller than base subgrids), e.g., S 1:
    +---+---+---+---+-------+-------+
    | b | b | b | b |       |       |
    +---+---+---+---+  2b   |  2b   |
    | b | b | b | b |       |       |
    +---+---+---+---+-------+-------+
    | b | b | b | b |       |       |
    +---+---+---+---+  2b   |  2b   |
    | b | b | b | b |       |       |
    +---+---+---+---+-------+-------+
    |       |       |       |       |
    |  2b   |  2b   |  2b   |  2b   |
    |       |       |       |       |
    +-------+-------+-------+-------+
    |       |       |       |       |
    |  2b   |  2b   |  2b   |  2b   |
    |       |       |       |       |
    +-------+-------+-------+-------+
    """
    if not (isinstance(nestingFactor, int) and nestingFactor >= 1):
        raise ValueError(
            f"nestingFactorSubgrid {nestingFactor=} not positive int"
        )
    if nestingFactor > 1 and not (nRowSubgrid and nColSubgrid):
        raise ValueError(
            f"nestingFactorSubgrid needs {nRowSubgrid=}, {nColSubgrid=} "
            "nonzero",
        )

    if not (isinstance(nestingLevelPeriod, int) and nestingLevelPeriod >= 0):
        raise ValueError(
            f"nestingLevelPeriodSubgrid {nestingLevelPeriod=} not "
            "nonnegative int"
        )
    if nestingLevelPeriod and not (nRowSubgrid and nColSubgrid):
        raise ValueError(
            f"nestingLevelPeriodSubgrid needs {nRowSubgrid=}, {nColSubgrid=} "
            "nonzero",
        )

    if not (isinstance(nestingLevelSplit, int) and nestingLevelSplit >= 0):
        raise ValueError(
            f"nestingLevelSplitSubgrid {nestingLevelSplit=} not "
            "nonnegative int"
        )
    if nestingLevelSplit and not (nRowSubgrid and nColSubgrid):
        raise ValueError(
            f"nestingLevelSplitSubgrid needs {nRowSubgrid=}, {nColSubgrid=} "
            "nonzero",
        )

    rows, cols = np.indices((nRow, nCol))
    if nestingLevelPeriod:  # restart nesting in each tile of L levels
        rows = rows % (nRowSubgrid * nestingFactor**nestingLevelPeriod)
        cols = cols % (nColSubgrid * nestingFactor**nestingLevelPeriod)
    # how many base (nRowSubgrid x nColSubgrid) subgrids from the corner
    baseSubgridsOut = np.maximum(
        rows // max(nRowSubgrid, 1), cols // max(nColSubgrid, 1)
    )

    # nesting level: how many of nestingFactor, nestingFactor^2, ... are at
    # most baseSubgridsOut; subgrids there are nestingFactor^level times base
    maxLevel = int(baseSubgridsOut.max()).bit_length()
    powers = nestingFactor ** np.arange(1, maxLevel + 1)
    level = np.sum(baseSubgridsOut[..., np.newaxis] >= powers, axis=-1)
    level = np.maximum(level - nestingLevelSplit, 0)  # split into smaller
    return (
        nRowSubgrid * nestingFactor**level,
        nColSubgrid * nestingFactor**level,
    )


def _make_subgrid_df(
    *, rowSubgrid: np.ndarray, colSubgrid: np.ndarray
) -> pl.DataFrame:
    """Describe each PE's place in the grid, given per-PE subgrid sizes (0 for
    no partitioning along that axis).

    Returns
    -------
    pl.DataFrame
        One row per PE, in row-major order, with the following columns:

        - 'row', 'col' : pl.Int64
            - PE position in grid.
        - 'nRow', 'nCol' : pl.Int64
            - Grid size.
        - 'nRowSubgrid', 'nColSubgrid' : pl.Int64
            - PE's subgrid size, as given (0 for none).
        - 'subgridOriginRow', 'subgridOriginCol' : pl.Int64
            - Subgrid's top-left PE, identifying its subgrid.
        - 'subgridRow', 'subgridCol' : pl.Int64
            - PE position within subgrid.
    """
    nRow, nCol = rowSubgrid.shape
    rows, cols = np.indices((nRow, nCol))
    subgridHeight = np.where(rowSubgrid, rowSubgrid, nRow)  # 0: whole grid
    subgridWidth = np.where(colSubgrid, colSubgrid, nCol)
    return pl.DataFrame(
        {
            "row": rows.ravel(),
            "col": cols.ravel(),
            "nRow": np.full(nRow * nCol, nRow),
            "nCol": np.full(nRow * nCol, nCol),
            "nRowSubgrid": rowSubgrid.ravel(),
            "nColSubgrid": colSubgrid.ravel(),
            "subgridOriginRow": (rows - rows % subgridHeight).ravel(),
            "subgridOriginCol": (cols - cols % subgridWidth).ravel(),
            "subgridRow": (rows % subgridHeight).ravel(),
            "subgridCol": (cols % subgridWidth).ravel(),
        }
    )


def _calc_symbol_values(
    *, calcConfig: dict, subgrid_df: pl.DataFrame, shape: tuple
) -> dict:
    """Calculate device symbol values, as raw word bits, from Python strings
    of polars expressions over subgrid_df (see `_make_subgrid_df`):
    with_setup adds columns, in order, then with_values gives each symbol's
    values.
    """
    if not calcConfig.keys() <= {"with_setup", "with_values"}:
        raise ValueError(f"calcSymbolValues {calcConfig.keys()=} invalid")
    env = {"np": np, "pl": pl}
    for expr in calcConfig.get("with_setup", []):
        subgrid_df = subgrid_df.with_columns(eval(expr, env))

    values_df = subgrid_df.select(
        **{
            symbol: eval(expr, env)
            for symbol, expr in calcConfig.get("with_values", {}).items()
        }
    )
    symbolValues = {
        symbol: values_df[symbol].to_numpy().reshape(shape)
        for symbol in values_df.columns
    }
    if error := _check_symbol_values(symbolValues=symbolValues, shape=shape):
        raise ValueError(f"calcSymbolValues {error}")
    return {symbol: v.view(np.uint32) for symbol, v in symbolValues.items()}


def _pair_p2p_targets(
    *, rowSubgrid: np.ndarray, colSubgrid: np.ndarray, seed: int
) -> np.ndarray:
    """Pair PEs at random within their subgrids, given per-PE subgrid sizes
    (0 for no partitioning along that axis).

    Returns each PE's target address (col << 16 | row), or 0xFFFFFFFF for the
    odd one out of a subgrid.
    """
    nRow, nCol = rowSubgrid.shape
    return (
        _make_subgrid_df(rowSubgrid=rowSubgrid, colSubgrid=colSubgrid)
        .select("row", "col", "subgridOriginRow", "subgridOriginCol")
        .with_columns(lot=pl.int_range(pl.len()).shuffle(seed=seed))
        # draw lots: in each subgrid, lowest two pair, then next two, etc.
        .with_columns(
            pair=(pl.col("lot").rank("ordinal") - 1).over(
                "subgridOriginRow", "subgridOriginCol"
            )
            // 2
        )
        # other PE value is pair's sum less own
        .with_columns(
            targetRow=pl.col("row")
            .sum()
            .over("subgridOriginRow", "subgridOriginCol", "pair")
            - pl.col("row"),
            targetCol=pl.col("col")
            .sum()
            .over("subgridOriginRow", "subgridOriginCol", "pair")
            - pl.col("col"),
        )
        # address packed as col << 16 | row; odd one out 0xFFFFFFFF
        .select(
            pl.when(
                pl.len().over("subgridOriginRow", "subgridOriginCol", "pair")
                == 2
            )
            .then(pl.col("targetCol") * 0x10000 | pl.col("targetRow"))
            .otherwise(0xFFFFFFFF)
            .cast(pl.UInt32)
        )
        .to_series()
        .to_numpy()
        .reshape(nRow, nCol)
    )


if __name__ == "__main__":
    comptime_config = json.load(sys.stdin)
    runtime_config = ${runtime_config}  # from jsonl
    print("dispatch_slug ${dispatch_slug}", file=sys.stderr)
    print(f"{comptime_config=}", file=sys.stderr)
    print(f"{runtime_config=}", file=sys.stderr)

    nRow, nCol = comptime_config["nRow"], comptime_config["nCol"]
    shape = (nRow, nCol, 1)
    # only what runtime config sets, others keep comptime config
    copiedSymbols = {
        f"rtc_{key}": np.full(shape, runtime_config[key], np.uint32)
        for key in sorted(
            {"globalSeed", "nCycleAtLeast"} & runtime_config.keys()
        )
    }

    setSymbols = _eval_symbol_values(
        exprs=runtime_config.get("setSymbolValues", {}), shape=shape
    )

    nRowSubgrid, nColSubgrid = (
        runtime_config.get(key, comptime_config[key])
        for key in ("nRowSubgrid", "nColSubgrid")
    )
    nestingFactor = runtime_config.get("nestingFactorSubgrid", 1)
    nestingLevelPeriod = runtime_config.get("nestingLevelPeriodSubgrid", 0)
    nestingLevelSplit = runtime_config.get("nestingLevelSplitSubgrid", 0)
    rowSubgrid, colSubgrid = _nest_subgrid_sizes(
        nRow=nRow,
        nCol=nCol,
        nRowSubgrid=nRowSubgrid,
        nColSubgrid=nColSubgrid,
        nestingFactor=nestingFactor,
        nestingLevelPeriod=nestingLevelPeriod,
        nestingLevelSplit=nestingLevelSplit,
    )
    subgridSymbols = {
        f"rtc_{key}": values[..., None].astype(np.uint32)
        for key, values in (
            ("nRowSubgrid", rowSubgrid),
            ("nColSubgrid", colSubgrid),
        )
        if nestingFactor > 1 or key in runtime_config
    }

    p2pSymbols = {}
    if "p2pSendProbability" in runtime_config:  # float32, copied as raw bits
        p2pSymbols["rtc_p2pSendProbability"] = np.full(
            shape, runtime_config["p2pSendProbability"], np.float32
        ).view(np.uint32)

    p2pMode = runtime_config.get("p2pMode", "none")
    if p2pMode == "none":
        pass
    elif p2pMode == "pairs":
        globalSeed = runtime_config.get(
            "globalSeed", comptime_config["globalSeed"]
        )
        p2pSeed = runtime_config.get("p2pSeed", globalSeed)
        p2pSymbols["rtc_p2pTarget"] = _pair_p2p_targets(
            rowSubgrid=rowSubgrid, colSubgrid=colSubgrid, seed=p2pSeed
        ).reshape(shape)
    else:
        raise ValueError(f"unknown {p2pMode=}")

    calcSymbols = _calc_symbol_values(
        calcConfig=runtime_config.get("calcSymbolValues", {}),
        subgrid_df=_make_subgrid_df(
            rowSubgrid=rowSubgrid, colSubgrid=colSubgrid
        ),
        shape=shape,
    )

    allSymbols = (
        copiedSymbols, setSymbols, subgridSymbols, p2pSymbols, calcSymbols
    )
    symbols = {k: v for items in allSymbols for k, v in items.items()}
    if len(symbols) != sum(map(len, allSymbols)):
        raise ValueError("runtime config options double set symbols")

    np.savez(sys.stdout.buffer, **symbols)
