"""Runtime config ${dispatch_slug}, from runtime_config_template/default.py.in.

Reads comptime configs as JSON from stdin, and writes an npz file of per-PE
values for rtc_* device symbols to stdout. See runtime_config_options.md.
"""

import itertools as it
import json
import sys

import numpy as np

if __name__ == "__main__":
    comptime_config = json.load(sys.stdin)
    runtime_config = ${runtime_config}  # from jsonl
    print("dispatch_slug ${dispatch_slug}", file=sys.stderr)
    print(f"{comptime_config=}", file=sys.stderr)
    print(f"{runtime_config=}", file=sys.stderr)

    nRow, nCol = comptime_config["nRow"], comptime_config["nCol"]
    shape = (nRow, nCol, 1)
    # only what runtime config sets, others keep comptime config
    symbols = {
        f"rtc_{key}": np.full(shape, runtime_config[key], np.uint32)
        for key in sorted(
            {"globalSeed", "nRowSubgrid", "nColSubgrid", "nCycleAtLeast"}
            & runtime_config.keys()
        )
    }
    if "p2pSendProbability" in runtime_config:  # float32, copied as raw bits
        symbols["rtc_p2pSendProbability"] = np.full(
            shape, runtime_config["p2pSendProbability"], np.float32
        ).view(np.uint32)

    p2pMode = runtime_config.get("p2pMode", "none")
    if p2pMode == "none":
        pass
    elif p2pMode == "pairs":
        globalSeed, nRowSubgrid, nColSubgrid = (
            runtime_config.get(key, comptime_config[key])
            for key in ("globalSeed", "nRowSubgrid", "nColSubgrid")
        )
        rng = np.random.default_rng(runtime_config.get("p2pSeed", globalSeed))
        tile = np.arange(nRow * nCol).reshape(nRow, nCol)
        partner = np.full((nRow * nCol, 2), 0xFFFFFFFF, dtype=np.uint32)
        for row, col in it.product(
            range(0, nRow, nRowSubgrid or nRow),
            range(0, nCol, nColSubgrid or nCol),
        ):
            subgrid = tile[
                row : row + (nRowSubgrid or nRow),
                col : col + (nColSubgrid or nCol),
            ]
            tiles = rng.permutation(subgrid.ravel())
            a, b = tiles[: len(tiles) // 2 * 2].reshape(-1, 2).T
            partner[a] = np.column_stack([b % nCol, b // nCol])  # col, row
            partner[b] = np.column_stack([a % nCol, a // nCol])

        # check partner's partner is self, and not self
        partner_tile = partner[:, 1].astype(int) * nCol + partner[:, 0]
        paired = np.flatnonzero(partner[:, 0] != 0xFFFFFFFF)
        assert (partner_tile[paired] != paired).all()
        assert (partner_tile[partner_tile[paired]] == paired).all()
        symbols["rtc_p2pPartner"] = partner.reshape(nRow, nCol, 2)
    else:
        raise ValueError(f"unknown {p2pMode=}")

    np.savez(sys.stdout.buffer, **symbols)
