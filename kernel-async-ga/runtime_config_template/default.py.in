"""Runtime config ${dispatch_slug}, from runtime_config_template/default.py.in.

Reads comptime configs as JSON from stdin, and writes an npz file of per-PE
values for rtc_* device symbols to stdout.

See `runtime_config_options.md`.
"""

import json
import sys

import numpy as np

if __name__ == "__main__":
    comptime_config = json.load(sys.stdin)
    runtime_config = ${runtime_config}  # from jsonl
    print("dispatch_slug ${dispatch_slug}", file=sys.stderr)
    print(f"{comptime_config=}", file=sys.stderr)
    print(f"{runtime_config=}", file=sys.stderr)

    nRow, nCol = comptime_config["nRow"], comptime_config["nCol"]
    shape = (nRow, nCol, 1)
    # only what runtime config sets, others keep comptime config
    symbols = {
        f"rtc_{key}": np.full(shape, runtime_config[key], np.uint32)
        for key in sorted(
            {"globalSeed", "nRowSubgrid", "nColSubgrid", "nCycleAtLeast"}
            & runtime_config.keys()
        )
    }

    # per-PE subgrid sizes, 0 for no partitioning along that axis
    nRowSubgrid, nColSubgrid = (
        runtime_config.get(key, comptime_config[key])
        for key in ("nRowSubgrid", "nColSubgrid")
    )
    rowSubgrid = np.full((nRow, nCol), nRowSubgrid)
    colSubgrid = np.full((nRow, nCol), nColSubgrid)

    # nested subgrids, e.g., nestingFactorSubgrid 2, with b = nRowSubgrid:
    # +---+---+-------+---------------+
    # | b | b |       |               |
    # +---+---+  2b   |               |
    # | b | b |       |               |
    # +---+---+-------+      4b       |
    # |       |       |               |
    # |  2b   |  2b   |               |
    # |       |       |               |
    # +-------+-------+---------------+
    # |               |               |
    # |               |               |
    # |               |               |
    # |      4b       |      4b       |
    # |               |               |
    # |               |               |
    # |               |               |
    # +---------------+---------------+
    # PE (0, 0) at top left; subgrids may overhang PE array
    factor = runtime_config.get("nestingFactorSubgrid", 1)
    if not isinstance(factor, int) or factor < 1:
        raise ValueError(f"nestingFactorSubgrid {factor=} not positive int")
    if factor > 1:
        if not nRowSubgrid or not nColSubgrid:
            raise ValueError(
                f"nestingFactorSubgrid needs {nRowSubgrid=}, {nColSubgrid=} "
                "nonzero",
            )
        rows, cols = np.indices((nRow, nCol))
        # how many base (nRowSubgrid x nColSubgrid) subgrids from the corner
        baseSubgridsOut = np.maximum(rows // nRowSubgrid, cols // nColSubgrid)
        # nesting level: how many of factor, factor^2, factor^3, ... that
        # distance reaches; subgrids there are factor^level times base size
        maxLevel = int(baseSubgridsOut.max()).bit_length()
        level = sum(
            (baseSubgridsOut >= factor**j for j in range(1, maxLevel + 1)),
            np.zeros_like(baseSubgridsOut),
        )
        rowSubgrid = nRowSubgrid * factor**level
        colSubgrid = nColSubgrid * factor**level
        for key, value in zip(
            ("nRowSubgrid", "nColSubgrid"), (rowSubgrid, colSubgrid)
        ):
            symbols[f"rtc_{key}"] = value.astype(np.uint32).reshape(shape)
    if "p2pSendProbability" in runtime_config:  # float32, copied as raw bits
        symbols["rtc_p2pSendProbability"] = np.full(
            shape, runtime_config["p2pSendProbability"], np.float32
        ).view(np.uint32)

    p2pMode = runtime_config.get("p2pMode", "none")
    if p2pMode == "none":
        pass
    elif p2pMode == "pairs":
        globalSeed = runtime_config.get(
            "globalSeed", comptime_config["globalSeed"]
        )
        rng = np.random.default_rng(runtime_config.get("p2pSeed", globalSeed))
        # subgrids, by tile id of their top-left PE, in row-major order
        rows, cols = np.indices((nRow, nCol))
        subgridTopRow = rows - rows % np.where(rowSubgrid, rowSubgrid, nRow)
        subgridLeftCol = cols - cols % np.where(colSubgrid, colSubgrid, nCol)
        corner = (subgridTopRow * nCol + subgridLeftCol).ravel()
        order = np.argsort(corner, kind="stable")  # row-major within subgrid
        bounds = np.flatnonzero(np.diff(corner[order])) + 1
        target = np.full(nRow * nCol, -1)  # tile id, -1 for none
        for subgrid in np.split(order, bounds):
            tiles = rng.permutation(subgrid)
            a, b = tiles[: len(tiles) // 2 * 2].reshape(-1, 2).T
            target[a], target[b] = b, a

        # check target's target is self, and not self
        paired = np.flatnonzero(target != -1)
        assert (target[paired] != paired).all()
        assert (target[target[paired]] == paired).all()
        symbols["rtc_p2pTarget"] = np.where(
            target != -1,
            (target % nCol) << 16 | (target // nCol),  # col << 16 | row
            0xFFFFFFFF,
        ).astype(np.uint32).reshape(shape)
    else:
        raise ValueError(f"unknown {p2pMode=}")

    np.savez(sys.stdout.buffer, **symbols)
