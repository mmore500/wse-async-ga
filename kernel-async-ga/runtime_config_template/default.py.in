"""Runtime config ${dispatch_slug}, from runtime_config_template/default.py.in.

Reads comptime configs as JSON from stdin, and writes an npz file of per-PE
values for rtc_* device symbols to stdout.

See `runtime_config_options.md`.
"""

import json
import sys

import numpy as np
import polars as pl


def _as_symbol_values(*, option: str, values: dict, shape: tuple) -> dict:
    """Check device symbol values, set by runtime config option, are rtc_
    symbols of 32-bit values of symbol shape, and give them as raw word bits.
    """
    symbols = {}
    for symbol, value in sorted(values.items()):
        if not symbol.startswith("rtc_"):
            raise ValueError(f"{option} {symbol=} invalid")
        if value.shape != shape or value.dtype.itemsize != 4:
            raise ValueError(f"{option} {symbol=} needs 32-bit {shape=}")
        symbols[symbol] = value.view(np.uint32)
    return symbols


def _update_symbols(symbols: dict, update: dict, *, option: str) -> None:
    """Add device symbol values set by runtime config option, which mustn't
    set any symbol already set."""
    if update.keys() & symbols.keys():
        raise ValueError(f"{option} double sets {update.keys()=}")
    symbols.update(update)


def _eval_symbol_values(*, exprs: dict, shape: tuple) -> dict:
    """Evaluate device symbol values from Python lambdas of symbol shape, e.g.,
    {"rtc_foo": "lambda shape: np.zeros(shape, np.int32)"}, as raw word bits.
    """
    return _as_symbol_values(
        option="setSymbolValues",
        values={
            symbol: eval(expr, {"np": np, "shape": shape})(shape)
            for symbol, expr in exprs.items()
        },
        shape=shape,
    )


def _nest_subgrid_sizes(
    *,
    nRow: int,
    nCol: int,
    nRowSubgrid: int,
    nColSubgrid: int,
    nestingFactor: int,
) -> tuple:
    """Per-PE subgrid sizes, nested outward from PE (0, 0) by nestingFactor.

    Nested subgrids, e.g., nestingFactor 2, with b = nRowSubgrid:
    +---+---+-------+---------------+
    | b | b |       |               |
    +---+---+  2b   |               |
    | b | b |       |               |
    +---+---+-------+      4b       |
    |       |       |               |
    |  2b   |  2b   |               |
    |       |       |               |
    +-------+-------+---------------+
    |               |               |
    |               |               |
    |               |               |
    |      4b       |      4b       |
    |               |               |
    |               |               |
    |               |               |
    +---------------+---------------+
    PE (0, 0) at top left; subgrids may overhang PE array.
    """
    if not (isinstance(nestingFactor, int) and nestingFactor >= 1):
        raise ValueError(
            f"nestingFactorSubgrid {nestingFactor=} not positive int"
        )
    if nestingFactor > 1 and not (nRowSubgrid and nColSubgrid):
        raise ValueError(
            f"nestingFactorSubgrid needs {nRowSubgrid=}, {nColSubgrid=} "
            "nonzero",
        )

    rows, cols = np.indices((nRow, nCol))
    # how many base (nRowSubgrid x nColSubgrid) subgrids from the corner
    baseSubgridsOut = np.maximum(
        rows // max(nRowSubgrid, 1), cols // max(nColSubgrid, 1)
    )

    # nesting level: how many of nestingFactor, nestingFactor^2, ... are at
    # most baseSubgridsOut; subgrids there are nestingFactor^level times base
    maxLevel = int(baseSubgridsOut.max()).bit_length()
    powers = nestingFactor ** np.arange(1, maxLevel + 1)
    level = np.sum(baseSubgridsOut[..., np.newaxis] >= powers, axis=-1)
    return (
        nRowSubgrid * nestingFactor**level,
        nColSubgrid * nestingFactor**level,
    )


def _grid_frame(
    *, rowSubgrid: np.ndarray, colSubgrid: np.ndarray
) -> pl.DataFrame:
    """One row per PE, in row-major order, describing its place in the grid,
    given per-PE subgrid sizes (0 for no partitioning along that axis).

    Columns: PE `row` and `col`; grid size `nRow` and `nCol`; PE subgrid size
    `nRowSubgrid` and `nColSubgrid` (0 for none, as given); subgrid top-left
    PE `subgridOriginRow` and `subgridOriginCol`, identifying its subgrid;
    PE position within subgrid, `subgridRow` and `subgridCol`.
    """
    nRow, nCol = rowSubgrid.shape
    rows, cols = np.indices((nRow, nCol))
    subgridHeight = np.where(rowSubgrid, rowSubgrid, nRow)  # 0: whole grid
    subgridWidth = np.where(colSubgrid, colSubgrid, nCol)
    return pl.DataFrame(
        {
            "row": rows.ravel(),
            "col": cols.ravel(),
            "nRow": np.full(nRow * nCol, nRow),
            "nCol": np.full(nRow * nCol, nCol),
            "nRowSubgrid": rowSubgrid.ravel(),
            "nColSubgrid": colSubgrid.ravel(),
            # subgrids identified by their top-left PE
            "subgridOriginRow": (rows - rows % subgridHeight).ravel(),
            "subgridOriginCol": (cols - cols % subgridWidth).ravel(),
            "subgridRow": (rows % subgridHeight).ravel(),
            "subgridCol": (cols % subgridWidth).ravel(),
        }
    )


def _calc_symbol_values(
    *, calcs: dict, grid: pl.DataFrame, shape: tuple
) -> dict:
    """Calculate device symbol values from Python strings of polars
    expressions over grid (one row per PE, see `_grid_frame`), as raw word
    bits, e.g., {"with_setup": ["(pl.col('row') + pl.col('col')).alias('d')"],
    "with_values": {"rtc_foo": "pl.col('d').cast(pl.UInt32)"}}.

    Each with_setup expression adds or replaces columns, in order (so each
    sees those before); then each with_values expression gives a symbol's
    per-PE values.
    """
    if not calcs.keys() <= {"with_setup", "with_values"}:
        raise ValueError(f"calcSymbolValues {calcs.keys()=} invalid")
    env = {"np": np, "pl": pl}
    for expr in calcs.get("with_setup", []):
        grid = grid.with_columns(eval(expr, env))

    values = {}
    for symbol, expr in calcs.get("with_values", {}).items():
        values[symbol] = grid.select(eval(expr, env)).to_series().to_numpy()
        if values[symbol].size == np.prod(shape):  # one value per PE
            values[symbol] = values[symbol].reshape(shape)
    return _as_symbol_values(
        option="calcSymbolValues", values=values, shape=shape
    )


def _pair_p2p_targets(
    *, rowSubgrid: np.ndarray, colSubgrid: np.ndarray, seed: int
) -> np.ndarray:
    """Pair PEs at random within their subgrids, given per-PE subgrid sizes
    (0 for no partitioning along that axis).

    Returns each PE's target address (col << 16 | row), or 0xFFFFFFFF for the
    odd one out of a subgrid.
    """
    nRow, nCol = rowSubgrid.shape
    return (
        _grid_frame(rowSubgrid=rowSubgrid, colSubgrid=colSubgrid)
        .select("row", "col", "subgridOriginRow", "subgridOriginCol")
        .with_columns(lot=pl.int_range(pl.len()).shuffle(seed=seed))
        # draw lots: in each subgrid, lowest two pair, then next two, etc.
        .with_columns(
            pair=(pl.col("lot").rank("ordinal") - 1).over(
                "subgridOriginRow", "subgridOriginCol"
            )
            // 2
        )
        # other PE value is pair's sum less own
        .with_columns(
            targetRow=pl.col("row")
            .sum()
            .over("subgridOriginRow", "subgridOriginCol", "pair")
            - pl.col("row"),
            targetCol=pl.col("col")
            .sum()
            .over("subgridOriginRow", "subgridOriginCol", "pair")
            - pl.col("col"),
        )
        # address packed as col << 16 | row; odd one out 0xFFFFFFFF
        .select(
            pl.when(
                pl.len().over("subgridOriginRow", "subgridOriginCol", "pair")
                == 2
            )
            .then(pl.col("targetCol") * 0x10000 | pl.col("targetRow"))
            .otherwise(0xFFFFFFFF)
            .cast(pl.UInt32)
        )
        .to_series()
        .to_numpy()
        .reshape(nRow, nCol)
    )


if __name__ == "__main__":
    comptime_config = json.load(sys.stdin)
    runtime_config = ${runtime_config}  # from jsonl
    print("dispatch_slug ${dispatch_slug}", file=sys.stderr)
    print(f"{comptime_config=}", file=sys.stderr)
    print(f"{runtime_config=}", file=sys.stderr)

    nRow, nCol = comptime_config["nRow"], comptime_config["nCol"]
    shape = (nRow, nCol, 1)
    # only what runtime config sets, others keep comptime config
    symbols = {
        f"rtc_{key}": np.full(shape, runtime_config[key], np.uint32)
        for key in sorted(
            {"globalSeed", "nRowSubgrid", "nColSubgrid", "nCycleAtLeast"}
            & runtime_config.keys()
        )
    }

    _update_symbols(
        symbols,
        _eval_symbol_values(
            exprs=runtime_config.get("setSymbolValues", {}), shape=shape
        ),
        option="setSymbolValues",
    )

    nRowSubgrid, nColSubgrid = (
        runtime_config.get(key, comptime_config[key])
        for key in ("nRowSubgrid", "nColSubgrid")
    )
    nestingFactor = runtime_config.get("nestingFactorSubgrid", 1)
    rowSubgrid, colSubgrid = _nest_subgrid_sizes(
        nRow=nRow,
        nCol=nCol,
        nRowSubgrid=nRowSubgrid,
        nColSubgrid=nColSubgrid,
        nestingFactor=nestingFactor,
    )
    if nestingFactor == 1:  # uniform subgrids, as without nesting
        assert (rowSubgrid == nRowSubgrid).all()
        assert (colSubgrid == nColSubgrid).all()
    else:
        symbols["rtc_nRowSubgrid"] = rowSubgrid[..., None].astype(np.uint32)
        symbols["rtc_nColSubgrid"] = colSubgrid[..., None].astype(np.uint32)

    if "p2pSendProbability" in runtime_config:  # float32, copied as raw bits
        symbols["rtc_p2pSendProbability"] = np.full(
            shape, runtime_config["p2pSendProbability"], np.float32
        ).view(np.uint32)

    p2pMode = runtime_config.get("p2pMode", "none")
    if p2pMode == "none":
        pass
    elif p2pMode == "pairs":
        globalSeed = runtime_config.get(
            "globalSeed", comptime_config["globalSeed"]
        )
        p2pSeed = runtime_config.get("p2pSeed", globalSeed)
        symbols["rtc_p2pTarget"] = _pair_p2p_targets(
            rowSubgrid=rowSubgrid, colSubgrid=colSubgrid, seed=p2pSeed
        ).reshape(shape)
    else:
        raise ValueError(f"unknown {p2pMode=}")

    # last, so expressions see final (e.g., nested) subgrid sizes
    _update_symbols(
        symbols,
        _calc_symbol_values(
            calcs=runtime_config.get("calcSymbolValues", {}),
            grid=_grid_frame(rowSubgrid=rowSubgrid, colSubgrid=colSubgrid),
            shape=shape,
        ),
        option="calcSymbolValues",
    )

    np.savez(sys.stdout.buffer, **symbols)
