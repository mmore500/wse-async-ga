// Emigration and immigration of genome messages, shared by population flavors.

// module params ==============================================================
param genome: imported_module;
param popSize: u16;

// module imports =============================================================
const opscalar = @import_module("cerebraslib/opscalar.csl");

// internal functions =========================================================
fn _get_ith_genome(pop: [*]u32, i: u16) [*]u32 {
    return @ptrcast([*]u32, &pop[i * genome.gWordsPop]);
}

// public API =================================================================
// pack messages of nGenomes uniformly sampled genomes into destBuf
fn emigrate_genomes(pop: [*]u32, destBuf: [*]u32, nGenomes: u16) void {
    for (@range(u16, nGenomes)) |i| {
        const sampled = _get_ith_genome(pop, opscalar.unif16(popSize));
        genome.msg_pack(sampled, destBuf, i);
    }
}

// immigrate nGenomes messages from srcBuf, each over a uniformly sampled
// resident (with replacement), which keeps its bits above the message;
// returns how many immigrants clobbered
fn immigrate_genomes(pop: [*]u32, srcBuf: [*]u32, nGenomes: u16) u32 {
    var nClobbers: u32 = 0;
    for (@range(u16, nGenomes)) |i| {
        // immigrant overwrites resident's message bits, in place
        const immigrant = _get_ith_genome(pop, opscalar.unif16(popSize));
        if (genome.hasImmClobber) {  // clobber compares with prior resident
            var prior = @zeros([genome.gWordsPop]u32);
            for (@range(u16, genome.gWordsPop)) |w| { prior[w] = immigrant[w]; }
            genome.msg_unpack(srcBuf, i, immigrant);
            const isClobbered = genome.clobber_immigrant(
                @ptrcast([*]u32, &prior), immigrant
            );
            nClobbers += @as(u32, isClobbered);
        } else {
            genome.msg_unpack(srcBuf, i, immigrant);
        }
    }
    return nClobbers;
}

// pack messages of up to nGenomes live genomes into destBuf, returning how
// many: if a sampled genome is live, it and those after it (wrapping), so
// nonzero with probability equal to the live fraction
fn emigrate_live_genomes(pop: [*]u32, destBuf: [*]u32, nGenomes: u16) u16 {
    const start = opscalar.unif16(popSize);
    if (genome.is_empty(_get_ith_genome(pop, start))) { return 0; }

    var nFound: u16 = 0;
    var offset: u16 = 0;
    while (nFound < nGenomes and offset < popSize) : (offset += 1) {
        const i = opscalar.addmod16(start, offset, popSize);
        const candidate = _get_ith_genome(pop, i);
        if (!genome.is_empty(candidate)) {
            genome.msg_pack(candidate, destBuf, nFound);
            nFound += 1;
        }
    }
    return nFound;
}
