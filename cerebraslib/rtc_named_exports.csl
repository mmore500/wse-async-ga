// Named runtime configs: per-PE values the host copies to device before
// launch, e.g., set uniformly across the device by runtime config jsonl keys
// "rtc_<name>:<type>" (see kernel-async-ga/runtime_config_options.md).
//
// A module (e.g., a genome) declares, exports, and reads each one, e.g.,
//   var rtc_foo = [1]f32{ compconf_default };
//   var ptr_rtc_foo: [*]f32 = &rtc_foo;
//   comptime { @export_symbol(ptr_rtc_foo, "rtc_foo"); }
// and lists it here, so layouts (kernel-async-ga and kernel-test-cerebraslib)
// export its name. Builds that don't include that module ignore the name.

/// Call from within a layout block.
fn export_names() void {
  // e.g., @export_name("rtc_foo", [*]f32, true);  // module that reads it
  // genome_alleleevoepi_2026_11_19
  @export_name("rtc_evoepi_mutationRate", [*]f32, true);
}
