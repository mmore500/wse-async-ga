// memory layout ===============================================================
// byte 0 SITES (u32, 4 bytes; bit indices below refer to the u32 word value)
// byte 1   bits 0-7: MLS sites (bit i -> effect size level i, see below)
// byte 2   bits 8-15: neutral sites (bits 8-11 initialized as 1's)
// byte 3   bits 16-31: NK landscape sites (N = 16, K via compconf)
// byte 4 CACHED NK FITNESS (f32, 4 bytes)
// byte 5
// byte 6
// byte 7
// byte 8 COUNTER (u32, 4 bytes)
// byte 9
// byte 10
// byte 11
// byte 12 BITFIELD (16 bytes)
// byte 13
// byte 14
// byte 15
// byte 16
// byte 17
// byte 18
// byte 19
// byte 20
// byte 21
// byte 22
// byte 23
// byte 24
// byte 25
// byte 26
// byte 27
// TOTAL: 7 words -> 28 bytes
//
// MLS sites ==================================================================
// Each MLS site is beneficial within a population (i.e., host), but harmful
// at the between-population level: immigrants carrying it are blocked from
// colonizing an empty population (i.e., clobbered) with some probability.
// Site i has base effect size s_i, for
//     s = [1.0, 0.5, 0.25, 0.1, 0.05, 0.025, 0.01, 0.005].
//
// Clobber chance for site i is s_i (times CEREBRASLIB_CLOBBER_IMMIGRANT_P,
// default 1.0); multiple MLS sites clobber independently.
//
// Within-population selective advantage for site i is rescaled to the actual
// population size, such that a selective sweep takes the same number of
// generations as a sweep with advantage s_i would in a reference population
// large enough to allow D = CEREBRASLIB_MLSNK_REFERENCE_DOUBLINGS (default 25)
// doublings. That is, a sweep takes ~log(N) / log(1 + s) generations, so
//     log2(N_actual) / log2(1 + s'_i) = D / log2(1 + s_i)
//     s'_i = (1 + s_i) ^ (log2(N_actual) / D) - 1.
// Note that s'_i ~= s_i * log2(N_actual) / D for small s_i.
//
// Because tournament selection compares fitness deterministically, this
// advantage is applied stochastically: on each fitness evaluation, each MLS
// site present independently adds a large bonus with probability s'_i. Under
// size-2 tournaments between otherwise-equal genomes, a carrier then wins with
// probability 1/2 + s'_i / 2, i.e., has relative fitness 1 + s'_i.
//
// NK sites ===================================================================
// Site i's fitness contribution depends on itself and the K following sites
// (wrapping around). Contributions are recomputed by hashing (site,
// neighborhood state, seed) rather than stored in a lookup table. NK fitness
// is the mean contribution, in [0, 1), cached in the genome and updated only
// when mutation changes an NK site.

//! {
//!     "dstream_algo": (
//!         "dstream." + compconf_data.get(
//!             "CEREBRASLIB_HSTRAT_DSTREAM_ALGO_NAME:comptime_string", "hybrid_0_steady_1_tilted_2_algo"
//!         ),
//!         pl.Categorical,
//!     ),
//!     "dstream_storage_bitoffset": (96, pl.UInt8),
//!     "dstream_storage_bitwidth": (128, pl.UInt8),
//!     "dstream_T_bitoffset": (64, pl.UInt8),
//!     "dstream_T_bitwidth": (32, pl.UInt8),
//!     "dstream_S": (128, pl.UInt8),
//!     "flag_site_bitwidth": (1, pl.UInt8),
//!     "flag_sites_bitoffset": (0, pl.UInt8),
//!     "flag_sites_bitwidth": (32, pl.UInt8),
//!     "flag_is_focal_mask_byte0": (0x00, pl.UInt8),
//!     "flag_is_focal_mask_byte1": (0x00, pl.UInt8),
//!     "flag_is_focal_mask_byte2": (0x00, pl.UInt8),
//!     "flag_is_focal_mask_byte3": (0xFF, pl.UInt8),
//!     "flag_is_nk_mask_byte0": (0xFF, pl.UInt8),
//!     "flag_is_nk_mask_byte1": (0xFF, pl.UInt8),
//!     "flag_is_nk_mask_byte2": (0x00, pl.UInt8),
//!     "flag_is_nk_mask_byte3": (0x00, pl.UInt8),
//!     "flag_nand_mask_byte0": (0x00, pl.UInt8),
//!     "flag_nand_mask_byte1": (0x00, pl.UInt8),
//!     "flag_nand_mask_byte2": (0x0F, pl.UInt8),
//!     "flag_nand_mask_byte3": (0x00, pl.UInt8),
//!     "nk_fitness_bitoffset": (32, pl.UInt8),
//!     "nk_fitness_bitwidth": (32, pl.UInt8),
//!     "nk_N": (16, pl.UInt8),
//!     "nk_K": (int(compconf_data.get("CEREBRASLIB_NK_K:u16", 3)), pl.UInt8),
//!     "nWav": (7, pl.UInt8),
//! }

// module imports =============================================================
const math = @import_module("<math>");
const random = @import_module("<random>");

const compconf = @import_module("<compconf>");
comptime { // access via get_value for logging...
    const _ = compconf.get_value_or(
        "CEREBRASLIB_HSTRAT_DSTREAM_ALGO_NAME",
        "hybrid_0_steady_1_tilted_2_algo",
    );
} // ... raw string works around sdk v1.0.0 limitation
const compconf_raw = @import_module("<compconf_raw>");
const has_value = compconf.has_value("CEREBRASLIB_HSTRAT_DSTREAM_ALGO_NAME");
const dstream_algo_name = (if (has_value)
    compconf_raw.CEREBRASLIB_HSTRAT_DSTREAM_ALGO_NAME
else
    "hybrid_0_steady_1_tilted_2_algo");
const dstream_algo = @import_module(
    @strcat("<downstream/dstream/", dstream_algo_name, ">"),
);

const bitmanip = @import_module("cerebraslib/bitmanip.csl");
const opscalar = @import_module("cerebraslib/opscalar.csl");

const S = 128;

// module config specs ========================================================
const gSize: u16 = 7;
const genome_t = [gSize]u32;
const genomePtr_t = [*]u32;
const nMlsSites: u16 = 8;
const nTraitVals: u16 = nMlsSites + 2; // clear, or 1 + number of MLS sites
const hasImmClobber: bool = true;

const mlsMask: u32 = 0x000000FF;
const neutralMask: u32 = 0x0000FF00;
const nkMask: u32 = 0xFFFF0000;
const nkShift: u32 = 16;
const nkN: u16 = 16;

// compile-time configuration =================================================
const nkK: u16 = compconf.get_value_or( //nofmt
    "CEREBRASLIB_NK_K", @as(u16, 3) // nofmt
);
comptime { @comptime_assert(nkK < nkN); }

const _nkSeed: u32 = compconf.get_value_or( //nofmt
    "CEREBRASLIB_NK_SEED", @as(u32, 0x2545F491) // nofmt
);

const _pmut_log2: u8 = compconf.get_value_or( //nofmt
    "CEREBRASLIB_LOG2_PMUT_BITWISE", // nofmt
    @as(u8, 18), // nofmt
);

const _fit_fudge: f32 = compconf.get_value_or( //nofmt
    "CEREBRASLIB_NONZERO_FIT_FUDGE", @as(f32, 0.0) // nofmt
);

const _p_clobber_scale: f32 = compconf.get_value_or( //nofmt
    "CEREBRASLIB_CLOBBER_IMMIGRANT_P", @as(f32, 1.0) // nofmt
);

// actual population size, used to rescale within-population advantage
const _popSize: u32 = compconf.get_value_or( //nofmt
    "ASYNC_GA_POPSIZE", @as(u32, 256) // nofmt
);
comptime { @comptime_assert(_popSize >= 1); }

const _referenceDoublings: f32 = compconf.get_value_or( //nofmt
    "CEREBRASLIB_MLSNK_REFERENCE_DOUBLINGS", @as(f32, 25.0) // nofmt
);
comptime { @comptime_assert(_referenceDoublings > 0.0); }

// MLS effect sizes ============================================================
// clobber chance per MLS site, i.e., base effect size s_i
var _mlsEffectSizes = [nMlsSites]f32{
    1.0, 0.5, 0.25, 0.1, 0.05, 0.025, 0.01, 0.005,
};
// natural log of (1 + s_i), hardcoded to avoid runtime transcendentals
var _mlsLog1pEffectSizes = [nMlsSites]f32{
    0.6931471805599453,
    0.4054651081081644,
    0.22314355131420976,
    0.09531017980432487,
    0.04879016416943201,
    0.0246926125903715,
    0.009950330853168083,
    0.004987541511039074,
};
// within-population selection probabilities s'_i, lazily initialized
var _mlsSelectionP = @zeros([nMlsSites]f32);
var _mlsSelectionPIsInit: bool = false;

// bonus added to fitness when an MLS site's advantage is expressed; exceeds
// the [1, 2) range of NK fitness so expressed advantage is decisive
const _mlsBonus: f32 = 2.0;

// internal functions =========================================================
/// Binary logarithm of a positive integer, via the shift-and-square method.
fn _log2_u32(n: u32) f32 {
    var intPart: u32 = 0;
    var v = n;
    while (v >= 2) {
        v >>= 1;
        intPart += 1;
    }
    var x: f32 = @as(f32, n) / @as(f32, @as(u32, 1) << intPart); // in [1, 2)
    var fracPart: f32 = 0.0;
    var bit: f32 = 0.5;
    for (@range(u16, 20)) |_| {
        x *= x;
        if (x >= 2.0) {
            x *= 0.5;
            fracPart += bit;
        }
        bit *= 0.5;
    }
    return @as(f32, intPart) + fracPart;
}

fn _init_mls_selection_p() void {
    const exponent = _log2_u32(_popSize) / _referenceDoublings;
    for (@range(u16, nMlsSites)) |i| {
        _mlsSelectionP[i] = math.exp(exponent * _mlsLog1pEffectSizes[i]) - 1.0;
    }
    _mlsSelectionPIsInit = true;
}

fn _get_mls_selection_p(site: u16) f32 {
    if (!_mlsSelectionPIsInit) _init_mls_selection_p();
    return _mlsSelectionP[site];
}

fn _get_mls_clobber_p(site: u16) f32 {
    return _mlsEffectSizes[site] * _p_clobber_scale;
}

/// Integer hash (lowbias32, by Chris Wellons).
fn _hash32(key: u32) u32 {
    var x = key;
    x ^= x >> 16;
    x *= 0x7FEB352D;
    x ^= x >> 15;
    x *= 0x846CA68B;
    x ^= x >> 16;
    return x;
}

/// Fitness contribution of NK site, in [0, 1), given 16-bit NK site states.
fn _calc_nk_contribution(site: u16, nkBits: u32) f32 {
    const nbMask: u32 = (@as(u32, 1) << (nkK + 1)) - 1;
    const doubled = (nkBits & 0xFFFF) | (nkBits << 16); // wrap neighborhood
    const neighborhood = (doubled >> @as(u32, site)) & nbMask;
    const key = ((@as(u32, site) << 16) | neighborhood) ^ _nkSeed;
    const h = _hash32(key);
    return @as(f32, h >> 8) * (1.0 / 16777216.0);
}

fn _calc_nk_fitness(genome: genomePtr_t) f32 {
    const nkBits = genome[0] >> nkShift;
    var total: f32 = 0.0;
    for (@range(u16, nkN)) |i| {
        total += _calc_nk_contribution(i, nkBits);
    }
    return total / @as(f32, nkN);
}

fn _get_cached_nk_fitness(genome: genomePtr_t) f32 {
    const fitnessPtr = @ptrcast(*f32, &genome[1]);
    return fitnessPtr.*;
}

fn _refresh_nk_fitness(genome: genomePtr_t) void {
    const fitness = _calc_nk_fitness(genome);
    const fitnessPtr = @ptrcast(*f32, &genome[1]);
    fitnessPtr.* = fitness;
}

fn _apply_mutation(genome: genomePtr_t, log2p: u8) void {
    bitmanip.mutate_log2p(@ptrcast([*]u16, genome), 2, log2p);
}

fn _step_instrumentation(genome: genomePtr_t) void {
    // elapse generation in bitfield
    if (opscalar.unifbool()) {
        const T = @ptrcast([*]u32, genome)[2];
        const site = dstream_algo.assign_storage_site(S, T);

        const offset_bits: u16 = (8 + 4) * 8;
        const target_bit = @as(u16, site) + offset_bits;

        const genome_bytes = @ptrcast([*]u8, genome);
        if (site != S) bitmanip.flip_nth_bit_with_swaps(
            genome_bytes,
            target_bit,
            .{ .byteSwap = true, .bitSwap = true },
        );
    }

    // elapse generation in counter
    @ptrcast([*]u32, genome)[2] += 1;
}

fn _elapse_inheritance_with(genome: genomePtr_t, log2p: u8) void {
    if (!_is_clear(genome)) {
        const before = genome[0];
        _apply_mutation(genome, log2p);
        // recompute cached NK fitness only if an NK site changed
        if (((before ^ genome[0]) & nkMask) != 0) _refresh_nk_fitness(genome);
        _step_instrumentation(genome); // elapse two steps per generation
        _step_instrumentation(genome);
    }
}

inline fn _clear(genome: genomePtr_t) void {
    genome[0] = 0;
    genome[1] = 0;
    genome[2] = 0;
    genome[3] = 0;
    genome[4] = 0;
    genome[5] = 0;
    genome[6] = 0;
}

inline fn _is_clear(genome: genomePtr_t) bool {
    const res: bool = genome[2] == 0;
    return res;
}

// public API =================================================================

fn elapse_inheritance_of(genome: genomePtr_t) void {
    _elapse_inheritance_with(genome, _pmut_log2);
}

fn calc_fitness_of(genome: genomePtr_t) f32 {
    if (_is_clear(genome)) return 0.0;

    var fitness: f32 = 1.0 + _get_cached_nk_fitness(genome);
    const mlsBits = genome[0] & mlsMask;
    if (mlsBits != 0) {
        for (@range(u16, nMlsSites)) |i| {
            const isSet = ((mlsBits >> @as(u32, i)) & 1) != 0;
            if (isSet and opscalar.p(_get_mls_selection_p(i))) {
                fitness += _mlsBonus;
            }
        }
    }
    fitness += random.random_f32(0.0, _fit_fudge);
    return fitness;
}

fn get_trait_value(genome: genomePtr_t) u32 {
    // 0: is_clear
    // 1 + n: not clear, has n MLS sites set
    if (_is_clear(genome)) return 0;
    return 1 + opscalar.popcnt32(genome[0] & mlsMask);
}

fn initialize_one(genome: genomePtr_t) void {
    _clear(genome);
    genome[0] |= 0x0F00; // initialize bottom 4 neutral sites as 1's
    // (to hint for testing endianness when decoding)
    genome[2] = S; // initialize counter to S
    // randomize hstrat bitfield
    bitmanip.randomize(@ptrcast([*]u16, &genome[3]), 8);
    _refresh_nk_fitness(genome);
}

fn clobber_immigrant(resident: genomePtr_t, immigrant: genomePtr_t) bool {
    if (!_is_clear(resident)) {
        _clear(immigrant);
        return true;
    }

    const mlsBits = immigrant[0] & mlsMask;
    if (mlsBits != 0) {
        for (@range(u16, nMlsSites)) |i| {
            const isSet = ((mlsBits >> @as(u32, i)) & 1) != 0;
            if (isSet and opscalar.p(_get_mls_clobber_p(i))) {
                _clear(immigrant);
                return true;
            }
        }
    }
    return false;
}
