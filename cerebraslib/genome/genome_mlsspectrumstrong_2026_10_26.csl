// memory layout ===============================================================
// byte 0 COUNTER (u16, 2 bytes)
// byte 1
// byte 2 FLAG SITES (2 bytes)
// byte 3   byte 2 bits 0-3: MLS sites (bit i -> effect size level i)
//          byte 2 bits 4-7: between-host deleterious sites (level i at 4+i)
//          byte 3 bits 0-3: within-host beneficial sites (level i at i)
//          byte 3 bits 4-7: neutral sites (start as 1's)
// byte 4 BITFIELD (16 bytes)
// byte 5
// byte 6
// byte 7
// byte 8
// byte 9
// byte 10
// byte 11
// byte 12
// byte 13
// byte 14
// byte 15
// byte 16
// byte 17
// byte 18
// byte 19
// TOTAL: 5 words -> 20 bytes
//
// Bytes are as stored on device (little-endian); in data_hex (big-endian
// words), word 0 reads as flag sites (beneficial/neutral byte, then
// MLS/deleterious byte), then counter. The counter saturates at 0xFFFF (~32k
// generations), after which instrumentation stops advancing.
//
// Lineage ===================================================================
// Copy of genome_mlsspectrum_2026_10_25 with stronger effect sizes
// (0.25, 0.1, 0.05, 0.025 instead of 0.05, 0.025, 0.01, 0.005).
// Mechanics follow genome_mlsspectrum_2026_10_15 (whole-population
// extinction and recolonization, within-population selection bonus, and
// immigrant clobbering), with the site types and effect sizes of
// genome_mlsindivspectra_2026_10_23, in its 5-word layout to save memory.
// Trait value follows genome_mlsspectrum_2026_10_15: 0 if clear, else 1 +
// number of MLS sites set.
//
// Site spectra ===============================================================
// Three spectra of 4 sites each, all with effect sizes by level i
//     s_i in [0.25, 0.1, 0.05, 0.025]:
//   * MLS sites: within-host beneficial AND between-host deleterious,
//   * between-host deleterious sites: clobber chance only,
//   * within-host beneficial sites: selective advantage only.
//
// Between-host deleterious effect: immigrants carrying the site are blocked
// from colonizing an empty population (i.e., clobbered) with chance s_i (times
// CEREBRASLIB_CLOBBER_IMMIGRANT_P, default 1.0); sites clobber independently.
// Immigrants are only accepted while the population is extinct (tracked via
// notify_extinct); the first non-empty immigrant to colonize ends extinction,
// so later immigrants are clobbered.
//
// Within-host beneficial effect: advantage for level i is rescaled to actual
// population size N so a sweep takes as many generations as one with
// advantage s_i would in a population allowing D =
// CEREBRASLIB_MLS_REFERENCE_DOUBLINGS (default 25) doublings:
//     s'_i = (1 + s_i) ^ (log2(N) / D) - 1.
// Tournament selection compares fitness deterministically, so on each fitness
// evaluation each beneficial site present independently adds a bonus with
// probability s'_i. In size-2 tournaments, a carrier then beats an
// otherwise-equal genome with probability 1/2 + s'_i / 2, i.e., has relative
// fitness 1 + s'_i.
//
// In data_hex, level-i sites are flag byte 1 bit i (MLS), flag byte 1 bit
// 4+i (between-host deleterious), and flag byte 0 bit i (within-host
// beneficial); the metadata below gives each site's clobber and selection
// probabilities (0 where a site has no such effect).

//! {
//!     "dstream_algo": (
//!         "dstream." + compconf_data.get(
//!             "CEREBRASLIB_HSTRAT_DSTREAM_ALGO_NAME:comptime_string", "hybrid_0_steady_1_tilted_2_algo"
//!         ),
//!         pl.Categorical,
//!     ),
//!     "dstream_storage_bitoffset": (32, pl.UInt8),
//!     "dstream_storage_bitwidth": (128, pl.UInt8),
//!     "dstream_T_bitoffset": (16, pl.UInt8),
//!     "dstream_T_bitwidth": (16, pl.UInt8),
//!     "dstream_S": (128, pl.UInt8),
//!     "flag_site_bitwidth": (1, pl.UInt8),
//!     "flag_sites_bitoffset": (0, pl.UInt8),
//!     "flag_sites_bitwidth": (16, pl.UInt8),
//!     "flag_is_focal_mask_byte0": (0x0F, pl.UInt8),
//!     "flag_is_focal_mask_byte1": (0xFF, pl.UInt8),
//!     "flag_nand_mask_byte0": (0xF0, pl.UInt8),
//!     "flag_nand_mask_byte1": (0x00, pl.UInt8),
//!     **{
//!         f"{kind}_{what}_p_byte{byte}_bit{bitoffset + bit}": (
//!             p * (what in effects), pl.Float32,
//!         )
//!         for kind, byte, bitoffset, effects in (
//!             ("mls", 1, 0, ("clobber", "selection")),
//!             ("deleterious", 1, 4, ("clobber",)),
//!             ("beneficial", 0, 0, ("selection",)),
//!         )
//!         for bit, s in enumerate((0.25, 0.1, 0.05, 0.025))
//!         for what, p in (
//!             ("clobber", s * float(compconf_data.get(
//!                 "CEREBRASLIB_CLOBBER_IMMIGRANT_P:f32", 1.0,
//!             ))),
//!             ("selection", (1.0 + s) ** (
//!                 __import__("math").log2(int(compconf_data.get(
//!                     "ASYNC_GA_POPSIZE:u32", 256,
//!                 ))) / float(compconf_data.get(
//!                     "CEREBRASLIB_MLS_REFERENCE_DOUBLINGS:f32", 25.0,
//!                 ))
//!             ) - 1.0),
//!         )
//!     },
//!     "nWav": (5, pl.UInt8),
//! }

// module imports =============================================================
const math = @import_module("<math>");
const random = @import_module("<random>");

const compconf = @import_module("<compconf>");
comptime { // access via get_value for logging...
    const _ = compconf.get_value_or(
        "CEREBRASLIB_HSTRAT_DSTREAM_ALGO_NAME",
        "hybrid_0_steady_1_tilted_2_algo",
    );
} // ... raw string works around sdk v1.0.0 limitation
const compconf_raw = @import_module("<compconf_raw>");
const has_value = comptime compconf.has_value(
    "CEREBRASLIB_HSTRAT_DSTREAM_ALGO_NAME",
);
const dstream_algo_name = (if (has_value)
    compconf_raw.CEREBRASLIB_HSTRAT_DSTREAM_ALGO_NAME
else
    "hybrid_0_steady_1_tilted_2_algo");
const dstream_algo = @import_module(
    @strcat("<downstream/dstream/", dstream_algo_name, ">"),
);

const bitmanip = @import_module("cerebraslib/bitmanip.csl");
const opscalar = @import_module("cerebraslib/opscalar.csl");

const S = 128;

// module config specs ========================================================
const gSize: u16 = 5;
const genome_t = [gSize]u32;
const genomePtr_t = [*]u32;
const nMlsSites: u16 = 4; // sites per spectrum, i.e., effect size levels
const nSpectrumSites: u16 = 3 * nMlsSites;
const nTraitVals: u16 = nMlsSites + 2; // clear, or 1 + number of MLS sites
const hasImmClobber: bool = true;
const hasNotifyExtinct: bool = true;

const mlsMask: u32 = 0x000F0000;
const deleteriousMask: u32 = 0x00F00000;
const beneficialMask: u32 = 0x0F000000;
const neutralMask: u32 = 0xF0000000;
const spectrumMask: u32 = mlsMask | deleteriousMask | beneficialMask;
const mlsShift: u32 = 16;
const deleteriousShift: u32 = 20;
const beneficialShift: u32 = 24;
const counterMax: u16 = 0xFFFF;

// compile-time configuration =================================================
const _pmut_log2: u8 = comptime compconf.get_value_or( //nofmt
    "CEREBRASLIB_LOG2_PMUT_BITWISE", // nofmt
    @as(u8, 18), // nofmt
);

const _fit_fudge: f32 = comptime compconf.get_value_or( //nofmt
    "CEREBRASLIB_NONZERO_FIT_FUDGE", @as(f32, 0.0) // nofmt
);

const _p_clobber_scale: f32 = comptime compconf.get_value_or( //nofmt
    "CEREBRASLIB_CLOBBER_IMMIGRANT_P", @as(f32, 1.0) // nofmt
);

// actual population size, used to rescale within-population advantage
const _popSize: u32 = comptime compconf.get_value_or( //nofmt
    "ASYNC_GA_POPSIZE", @as(u32, 256) // nofmt
);
comptime { @comptime_assert(_popSize >= 1); }

const _referenceDoublings: f32 = comptime compconf.get_value_or( //nofmt
    "CEREBRASLIB_MLS_REFERENCE_DOUBLINGS", @as(f32, 25.0) // nofmt
);
comptime { @comptime_assert(_referenceDoublings > 0.0); }

// MLS effect sizes ============================================================
// clobber chance per MLS site, i.e., base effect size s_i
var _mlsEffectSizes = [nMlsSites]f32{
    0.25, 0.1, 0.05, 0.025,
};
// natural log of (1 + s_i), hardcoded to avoid runtime transcendentals
var _mlsLog1pEffectSizes = [nMlsSites]f32{
    0.22314355131420976,
    0.09531017980432487,
    0.04879016416943201,
    0.0246926125903715,
};
// within-population selection probabilities s'_i, lazily initialized
var _mlsSelectionP = @zeros([nMlsSites]f32);
var _mlsSelectionPIsInit: bool = false;

// is this population extinct (i.e., open to colonization by immigrants)?
// set by notify_extinct, cleared once an immigrant colonizes
var _isExtinct: bool = false;

// bonus added to fitness when a site's within-host advantage is expressed
const _mlsBonus: f32 = 1.0;

// internal functions =========================================================
/// Binary logarithm of a positive integer, via the shift-and-square method.
fn _log2_u32(n: u32) f32 {
    var intPart: u32 = 0;
    var v = n;
    while (v >= 2) {
        v >>= 1;
        intPart += 1;
    }
    var x: f32 = @as(f32, n) / @as(f32, @as(u32, 1) << intPart); // in [1, 2)
    var fracPart: f32 = 0.0;
    var bit: f32 = 0.5;
    for (@range(u16, 20)) |_| {
        x *= x;
        if (x >= 2.0) {
            x *= 0.5;
            fracPart += bit;
        }
        bit *= 0.5;
    }
    return @as(f32, intPart) + fracPart;
}

fn _init_mls_selection_p() void {
    const exponent = _log2_u32(_popSize) / _referenceDoublings;
    for (@range(u16, nMlsSites)) |i| {
        _mlsSelectionP[i] = math.exp(exponent * _mlsLog1pEffectSizes[i]) - 1.0;
    }
    _mlsSelectionPIsInit = true;
}

fn _get_mls_selection_p(site: u16) f32 {
    if (!_mlsSelectionPIsInit) _init_mls_selection_p();
    return _mlsSelectionP[site];
}

fn _get_mls_clobber_p(site: u16) f32 {
    return _mlsEffectSizes[site] * _p_clobber_scale;
}

/// Total fitness bonus expressed by within-host beneficial sites, given a
/// 4-bit field of sites present, indexed by effect size level.
fn _calc_selection_bonus(levelBits: u32) f32 {
    var bonus: f32 = 0.0;
    if (levelBits != 0) {
        for (@range(u16, nMlsSites)) |i| {
            const isSet = ((levelBits >> @as(u32, i)) & 1) != 0;
            if (isSet and opscalar.p(_get_mls_selection_p(i))) {
                bonus += _mlsBonus;
            }
        }
    }
    return bonus;
}

/// Does any between-host deleterious site clobber its carrier, given a
/// 4-bit field of sites present, indexed by effect size level?
fn _sample_clobber(levelBits: u32) bool {
    if (levelBits != 0) {
        for (@range(u16, nMlsSites)) |i| {
            const isSet = ((levelBits >> @as(u32, i)) & 1) != 0;
            if (isSet and opscalar.p(_get_mls_clobber_p(i))) return true;
        }
    }
    return false;
}

fn _get_counter(genome: genomePtr_t) u16 {
    const genome_halfwords = @ptrcast([*]u16, genome);
    return genome_halfwords[0];
}

fn _apply_mutation(genome: genomePtr_t, log2p: u8) void {
    // flip each flag site (upper half of word 0) with probability 2^-log2p
    var mask: u32 = 0xFFFF;
    for (@range(u8, log2p)) |_| { mask &= @as(u32, @random16()); }
    genome[0] ^= mask << 16;
}

fn _step_instrumentation(genome: genomePtr_t) void {
    // saturated counter stops instrumentation, rather than wrapping to clear
    if (_get_counter(genome) == counterMax) return;

    // elapse generation in bitfield
    if (opscalar.unifbool()) {
        const T = @as(u32, _get_counter(genome));
        const site = dstream_algo.assign_storage_site(S, T);

        const offset_bits: u16 = 4 * 8;
        const target_bit = @as(u16, site) + offset_bits;

        const genome_bytes = @ptrcast([*]u8, genome);
        if (site != S) bitmanip.flip_nth_bit_with_swaps(
            genome_bytes,
            target_bit,
            .{ .byteSwap = true, .bitSwap = true },
        );
    }

    // elapse generation in counter
    const genome_halfwords = @ptrcast([*]u16, genome);
    genome_halfwords[0] += 1;
}

inline fn _clear(genome: genomePtr_t) void {
    genome[0] = 0;
    genome[1] = 0;
    genome[2] = 0;
    genome[3] = 0;
    genome[4] = 0;
}

inline fn _is_clear(genome: genomePtr_t) bool {
    const res: bool = _get_counter(genome) == 0;
    return res;
}

// public API =================================================================

fn elapse_inheritance_of(genome: genomePtr_t) void {
    if (!_is_clear(genome)) {
        _apply_mutation(genome, _pmut_log2);
        _step_instrumentation(genome); // elapse two steps per generation
        _step_instrumentation(genome);
    }
}

fn calc_fitness_of(genome: genomePtr_t) f32 {
    if (_is_clear(genome)) return 0.0;

    var fitness: f32 = 1.0;
    fitness += _calc_selection_bonus((genome[0] & mlsMask) >> mlsShift);
    fitness += _calc_selection_bonus(
        (genome[0] & beneficialMask) >> beneficialShift
    );
    fitness += random.random_f32(0.0, _fit_fudge);
    return fitness;
}

fn get_trait_value(genome: genomePtr_t) u32 {
    // 0: is_clear
    // 1 + n: not clear, has n MLS sites set
    if (_is_clear(genome)) return 0;
    return 1 + opscalar.popcnt32(genome[0] & mlsMask);
}

fn initialize_one(genome: genomePtr_t) void {
    _clear(genome);
    genome[0] |= neutralMask; // initialize 4 neutral sites as 1's
    // (to hint for testing endianness when decoding)
    genome[0] |= S; // initialize counter to S
    // randomize hstrat bitfield
    bitmanip.randomize(@ptrcast([*]u16, &genome[1]), 8);
}

fn clobber_immigrant(resident: genomePtr_t, immigrant: genomePtr_t) bool {
    // only extinct populations accept immigrants; otherwise, overwrite
    // immigrant with resident so that copying immigrant in is a no-op
    if (!_isExtinct) {
        for (@range(u16, gSize)) |i| { immigrant[i] = resident[i]; }
        return true;
    }

    const mlsBits = (immigrant[0] & mlsMask) >> mlsShift;
    const deleteriousBits = (
        (immigrant[0] & deleteriousMask) >> deleteriousShift
    );
    if (_sample_clobber(mlsBits) or _sample_clobber(deleteriousBits)) {
        _clear(immigrant);
        return true;
    }

    // a non-empty immigrant colonizes, so population is no longer extinct
    if (!_is_clear(immigrant)) _isExtinct = false;
    return false;
}

fn trample_resident(resident: genomePtr_t, spawn: genomePtr_t) void {
    // an empty tournament winner never displaces a living resident, so a
    // lone founder can't be lost while its refounded tile fills in
    if (_is_clear(spawn) and !_is_clear(resident)) return;
    for (@range(u16, gSize)) |i| { resident[i] = spawn[i]; }
}

fn notify_extinct() void { _isExtinct = true; }
