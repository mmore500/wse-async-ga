// memory layout ===============================================================
// byte 0 BITFIELD (12 bytes)
// byte 1
// byte 2
// byte 3
// byte 4
// byte 5
// byte 6
// byte 7
// byte 8
// byte 9
// byte 10
// byte 11
// TOTAL: 3 words -> 12 bytes

//! {
//!     "nWav": (3, pl.UInt8),
//! }

// module config specs ========================================================
const gSize: u16 = 3;
const genome_t = [gSize]u32;
const genomePtr_t = [*]u32;
const nTraitVals: u16 = 1;
const hasImmClobber: bool = false;
const hasNotifyExtinct: bool = false;

// memory layout struct =======================================================
const fields_t = extern struct {
    literal: [gSize]u32, // byte 0
};

/// View genome words through memory layout struct.
fn _cast_fields(genome: genomePtr_t) *fields_t {
    return @ptrcast(*fields_t, genome);
}

const val1: u32 = 1692398096;
const val2: u32 = 2816128869;
const val3: u32 = 2428220313;

fn _validate(genome: genomePtr_t) bool {
    return (_cast_fields(genome).*.literal[0] == val1) and (_cast_fields(genome).*.literal[1] == val2) and (_cast_fields(genome).*.literal[2] == val3);
}

// public API =================================================================
fn elapse_inheritance_of(genome: genomePtr_t) void {
    @assert(_validate(genome));
}

fn calc_fitness_of(genome: genomePtr_t) f32 {
    @assert(_validate(genome));
    return 0.0;
}

fn get_trait_value(genome: genomePtr_t) u32 { return 0; }

fn initialize_one(genome: genomePtr_t) void {
    _cast_fields(genome).*.literal[0] = val1;
    _cast_fields(genome).*.literal[1] = val2;
    _cast_fields(genome).*.literal[2] = val3;
    @assert(_validate(genome));
}

fn clobber_immigrant(resident: genomePtr_t, immigrant: genomePtr_t) bool { return false; }

fn trample_resident(resident: genomePtr_t, spawn: genomePtr_t) void {
    for (@range(u16, gSize)) |i| { resident[i] = spawn[i]; }
}

fn notify_extinct() void {}

/// Is genome an empty slot (e.g., no individual), so not worth sending to
/// other PEs by p2p?
fn is_empty(genome: genomePtr_t) bool { return false; }
