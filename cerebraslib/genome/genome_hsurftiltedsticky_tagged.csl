// memory layout ===============================================================
// byte 0 TAG (u16, 2 bytes)
// byte 1
// byte 2 COUNTER (u16, 2 bytes)
// byte 3
// byte 4 BITFIELD (8 bytes)
// byte 5
// byte 6
// byte 7
// byte 8
// byte 9
// byte 10
// byte 11
// TOTAL: 3 words -> 12 bytes

//! {
//!     "nWav": (3, pl.UInt8),
//! }

// module imports =============================================================
const bitmanip = @import_module("cerebraslib/bitmanip.csl");
const opscalar = @import_module("cerebraslib/opscalar.csl");
const tilted = @import_module("cerebraslib/tilted_sticky.csl");

// module config specs ========================================================
const gSize: u16 = 3;
const genome_t = [gSize]u32;
const genomePtr_t = [*]u32;
const nTraitVals: u16 = 1;
const hasImmClobber: bool = false;
const hasNotifyExtinct: bool = false;

// memory layout struct =======================================================
const fields_t = extern struct {
    tag: u16, // byte 0
    hstrat_T: u16, // byte 2
    hstrat_storage: [2]u32, // byte 4
};

/// View genome words through memory layout struct.
fn _cast_fields(genome: genomePtr_t) *fields_t {
    return @ptrcast(*fields_t, genome);
}

// internal functions =========================================================
fn _step_instrumentation(genome: genomePtr_t) void {
    // elapse generation in bitfield
    if (opscalar.unifbool()) {
        const rank = @as(u32, _cast_fields(genome).*.hstrat_T);
        const site = tilted.pick_deposition_site(rank, 64);

        const target_bit = @as(u16, site);

        const storage_bytes = @ptrcast([*]u8, &_cast_fields(genome).*.hstrat_storage);
        bitmanip.flip_nth_bit(storage_bytes, target_bit);
    }

    // elapse generation in counter
    _cast_fields(genome).*.hstrat_T += 1;
}

// public API =================================================================
fn elapse_inheritance_of(genome: genomePtr_t) void {
    _step_instrumentation(genome);
}

fn calc_fitness_of(genome: genomePtr_t) f32 {
    return 0.0;
}

fn get_trait_value(genome: genomePtr_t) u32 {
    return 0;
}

fn initialize_one(genome: genomePtr_t) void {
    const gHalfWords: u16 = gSize * 2;
    bitmanip.randomize(@ptrcast([*]u16, genome), gHalfWords);
    _cast_fields(genome).*.hstrat_T = 0;
    // tag bits left randomized
}

fn clobber_immigrant(resident: genomePtr_t, immigrant: genomePtr_t) bool { return false; }

fn trample_resident(resident: genomePtr_t, spawn: genomePtr_t) void {
    for (@range(u16, gSize)) |i| { resident[i] = spawn[i]; }
}

fn notify_extinct() void {}

/// Is genome an empty slot (e.g., no individual), so not worth sending to
/// other PEs by p2p?
fn is_empty(genome: genomePtr_t) bool { return false; }
