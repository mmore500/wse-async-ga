// memory layout ===============================================================
// byte 0 BITFIELD (12 bytes)
// byte 1
// byte 2
// byte 3
// byte 4
// byte 5
// byte 6
// byte 7
// byte 8
// byte 9
// byte 10
// byte 11
// byte 12
// byte 13
// byte 14
// byte 15
// byte 16
// byte 17
// byte 18
// byte 19
// byte 20
// byte 21
// byte 22
// byte 23
// byte 24
// byte 25
// byte 26
// byte 27
// TOTAL: 7 words -> 28 bytes

//! {
//!     "nWav": (7, pl.UInt8),
//! }

// module config specs ========================================================
const _gSize: u16 = 7;
const gWordsPop: u16 = _gSize;  // size used in local population
const gWordsD2h: u16 = _gSize;  // size copied to host
const gBitsMsg: u16 = 32 * _gSize;  // size migrated between PEs
const genome_t = [_gSize]u32;
const genomePtr_t = [*]u32;
const nTraitVals: u16 = 1;
const hasImmClobber: bool = false;
const hasNotifyExtinct: bool = false;

// memory layout struct =======================================================
const fields_t = extern struct {
    literal: [_gSize]u32, // byte 0
};

/// View genome words through memory layout struct.
fn _cast_fields(genome: genomePtr_t) *fields_t {
    return @ptrcast(*fields_t, genome);
}

const val1: u32 = 1692398096;
const val2: u32 = 2816128869;
const val3: u32 = 2428220313;
const val4: u32 = 1428255001;
const val5: u32 = 1002100039;
const val6: u32 = 3010301098;
const val7: u32 = 3113342294;

fn _validate(genome: genomePtr_t) bool {
    return (
        (_cast_fields(genome).*.literal[0] == val1)
        and (_cast_fields(genome).*.literal[1] == val2)
        and (_cast_fields(genome).*.literal[2] == val3)
        and (_cast_fields(genome).*.literal[3] == val4)
        and (_cast_fields(genome).*.literal[4] == val5)
        and (_cast_fields(genome).*.literal[5] == val6)
        and (_cast_fields(genome).*.literal[6] == val7)
    );
}

// public API =================================================================
fn elapse_inheritance_of(genome: genomePtr_t) void {
    @assert(_validate(genome));
}

fn calc_fitness_of(genome: genomePtr_t) f32 {
    @assert(_validate(genome));
    return 0.0;
}

fn get_trait_value(genome: genomePtr_t) u32 { return 0; }

fn initialize_one(genome: genomePtr_t) void {
    _cast_fields(genome).*.literal[0] = val1;
    _cast_fields(genome).*.literal[1] = val2;
    _cast_fields(genome).*.literal[2] = val3;
    _cast_fields(genome).*.literal[3] = val4;
    _cast_fields(genome).*.literal[4] = val5;
    _cast_fields(genome).*.literal[5] = val6;
    _cast_fields(genome).*.literal[6] = val7;
    @assert(_validate(genome));
}

fn clobber_immigrant(resident: genomePtr_t, immigrant: genomePtr_t) bool { return false; }

fn trample_resident(resident: genomePtr_t, spawn: genomePtr_t) void {
    for (@range(u16, _gSize)) |i| { resident[i] = spawn[i]; }
}

fn notify_extinct() void {}

fn is_empty(genome: genomePtr_t) bool { return false; }  // never empty

// copy genome into buf as buf's ith message (whole genome)
fn msg_pack(srcPtr: genomePtr_t, destBuf: [*]u32, i: u16) void {
    for (@range(u16, _gSize)) |w| { destBuf[i * _gSize + w] = srcPtr[w]; }
}

// copy buf's ith message (whole genome) into genome
fn msg_unpack(srcBuf: [*]u32, i: u16, destPtr: genomePtr_t) void {
    for (@range(u16, _gSize)) |w| { destPtr[w] = srcBuf[i * _gSize + w]; }
}

fn export_symbol_names() void {}  // hook into top-level layout block
