// module params ==============================================================
param numBits: u16;
param numMultiplex: u16;  // independent single-bit records packed back-to-back
param dstreamAlgoName: comptime_string;
param symbolName: comptime_string;

// module imports =============================================================
const dstream_algo = @import_module(
    @strcat("<downstream/dstream/", dstreamAlgoName, ">"),
);

const bitmanip = @import_module("cerebraslib/bitmanip.csl");

// global state ===============================================================
// record layout:
// - each multiplexed record's numBits bits, back to back
// - then one u32 last seen T, shared by all records (+2 halfwords)
// a sample is seen if any record's bit is set
const numHalfWords = numBits >> 4;
comptime { @comptime_assert(numMultiplex > 0 and numMultiplex <= 32); }

var dstream_T: u32 = 0;
// +2 are u32 last seen T
var recordBuffer = @zeros([numMultiplex * numHalfWords + 2]u16);
var pendingBuffer = @zeros([numHalfWords]u16);  // shared by all records
var ptr_recordBuffer : [*]u16 = &recordBuffer;

const recordDsd = @get_dsd(mem1d_dsd, .{  // offset for other records
    .tensor_access = |i|{numHalfWords} -> recordBuffer[i],
});
const pendingDsd = @get_dsd(mem1d_dsd, .{
    .tensor_access = |i|{numHalfWords} -> pendingBuffer[i],
});


// module functions ===========================================================
///////////////////////////////////////////////////////////////////////////////

fn _last_seen_T_ptr() *u32 {
    return @ptrcast(*u32, &recordBuffer[numMultiplex * numHalfWords]);
}

// public API =================================================================
fn update(sample: u32) void {
    const site = @as(u16, dstream_algo.assign_storage_site(numBits, dstream_T));

    const dstream_S = numBits;
    if (sample != 0) {  // seen
        // mask out any pending zeros, in all multiplexed records...
        for (@range(u16, numMultiplex)) |record| {
            const dsd = @increment_dsd_offset(
                recordDsd, @as(i16, record * numHalfWords), u16
            );
            @or16(dsd, dsd, pendingDsd);  // (x or y) xor y is same as
            @xor16(dsd, dsd, pendingDsd); // x & (~y)
        }
        @mov16(pendingDsd, 0);

        // ... and write each multiplexed record's bit, set or not
        if (site != dstream_S) {
            var remaining = sample;  // shifted down as records are written
            for (@range(u16, numMultiplex)) |record| {
                const record_bytes = @ptrcast(
                    [*]u8, &recordBuffer[record * numHalfWords]
                );
                bitmanip.set_nth_bit_with_swaps(
                    record_bytes,
                    site,
                    (remaining & 1) != 0,
                    .{ .byteSwap = true, .bitSwap = true },
                );
                remaining >>= 1;
            }
        }
        const last_seen_T_ptr = _last_seen_T_ptr();
        last_seen_T_ptr.* = dstream_T + 1;
    } else {  // all multiplexed records zero, write lazily on next seen sample
        const pending_bytes = @ptrcast([*]u8, &pendingBuffer[0]);
        if (site != dstream_S) bitmanip.set_nth_bit_with_swaps(
            pending_bytes,
            site,
            true,
            .{ .byteSwap = true, .bitSwap = true },
        );
    }

    dstream_T += 1;
}


fn reset() void {
    @mov16(pendingDsd, 0);
    for (@range(u16, numMultiplex)) |record| {
        @mov16(
            @increment_dsd_offset(
                recordDsd, @as(i16, record * numHalfWords), u16
            ),
            0,
        );
    }
    const last_seen_T_ptr = _last_seen_T_ptr();
    last_seen_T_ptr.* = 0;
    dstream_T = 0;
}

comptime {  // symbols let memcpy gather end-state data from device to host
    if (@strlen(symbolName) > 0) {  // empty name skips export for testing
        @export_symbol(ptr_recordBuffer, symbolName);
    }
}
