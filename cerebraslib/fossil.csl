// module params ==============================================================
param genome: imported_module;
param population: imported_module;
param rng: imported_module;
// fossil sampling mode, see FossilSampling below
param sampling: comptime_string;

// module imports =============================================================
const enum_ = @import_module("cerebraslib/enum.csl");

// sampling mode ==============================================================
//   snapshot: 0th population member at collection time
//   reservoir: reservoir sample one genome (0th population member) per
//     generation, so that between consecutive fossil collections each
//     generation's sampled genome is equally likely to be streamed fossil
const FossilSampling = enum(u8) { snapshot, reservoir };

fn fossil_sampling_from_string(
    comptime name: comptime_string,
) FossilSampling {
    return enum_.from_string(
        FossilSampling,
        .{
            .snapshot = FossilSampling.snapshot,
            .reservoir = FossilSampling.reservoir,
        },
        name,
    );
}

const samplingMode = fossil_sampling_from_string(sampling);

// global state ===============================================================
// reservoir of one genome, sampled uniformly across generations elapsed since
// last fossil collection (used only in reservoir mode)
var reservoirGenome = @zeros([genome.gSize]u32);
var reservoirCount: u32 = 0;  // generations sampled since last collection

// module functions ===========================================================
///////////////////////////////////////////////////////////////////////////////

// reservoir sampling (algorithm R) with reservoir size one: kth generation
// since last collection replaces reservoir with probability 1 / k
fn _reservoir_sample() void {
    reservoirCount += 1;
    if (rng.next() % reservoirCount == 0) {
        const genomePtr = population._get_ith_genome(0);
        for (@range(u16, genome.gSize)) |i| {
            reservoirGenome[i] = genomePtr[i];
        }
    }
}

/// Get pointer to genome to stream back as fossil, and reset sampling window.
/// In reservoir mode, falls back to 0th population member if no generations
/// have elapsed since last collection.
fn _take_fossil() [*]u32 {
    const useReservoir = (
        samplingMode == FossilSampling.reservoir and reservoirCount > 0
    );
    reservoirCount = 0;  // start new sampling window
    return if (useReservoir)
        @ptrcast([*]u32, &reservoirGenome)
    else
        population._get_ith_genome(0);
}

// public interface ===========================================================
/// Call once per generation, after population.do_generation().
fn update() void {
    if (samplingMode == FossilSampling.reservoir) { _reservoir_sample(); }
}

/// Fill bookend buffer (length genome.gSize + 2) with fossil genome. First
/// and last words hold a 10-bit refresh counter, with `tag` in upper bits,
/// so host can validate that memcpy did not tear.
fn refresh(bookend: [*]u32, tag: u32) void {
    const genomePtr = _take_fossil();
    bookend[genome.gSize + 1] += 1;
    bookend[genome.gSize + 1] &= 0x3FF;  // clear upper bits
    bookend[genome.gSize + 1] |= tag << 10;  // set tag
    for (@range(u16, genome.gSize)) |i| {
        bookend[i + 1] = genomePtr[i];
    }
    bookend[0] += 1;
    bookend[0] &= 0x3FF;  // clear upper bits
    bookend[0] |= tag << 10;  // set tag
}
