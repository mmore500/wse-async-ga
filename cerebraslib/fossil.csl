// module params ==============================================================
param genome: imported_module;
param population: imported_module;
param rng: imported_module;
param samplingMode: comptime_string;
param symbolName: comptime_string;

// module imports =============================================================
const enum_ = @import_module("cerebraslib/enum.csl");

// sampling mode ==============================================================
const FossilSampling = enum(u8) {
    snapshot,  // 0th population member at collection time
    reservoir,  // 0th population member, uniform across generations
};

fn fossil_sampling_from_string(
    comptime name: comptime_string,
) FossilSampling {
    return enum_.from_string(
        FossilSampling,
        .{
            .snapshot = FossilSampling.snapshot,
            .reservoir = FossilSampling.reservoir,
        },
        name,
    );
}

const samplingMode_ = fossil_sampling_from_string(samplingMode);

// global state ===============================================================
var bookendBuffer = @zeros([genome.gSize + 2]u32);  // w/ bookend validation
var ptr_bookendBuffer : [*]u32 = &bookendBuffer;

var reservoirGenome = @zeros([genome.gSize]u32);
var reservoirCount: u32 = 0;  // generations since last collection

// module functions ===========================================================
///////////////////////////////////////////////////////////////////////////////

// reservoir sample (algorithm R), kth generation kept w/ probability 1 / k
fn _reservoir_sample() void {
    reservoirCount += 1;
    if (rng.p_one_in(reservoirCount)) {
        const genomePtr = population._get_ith_genome(0);
        for (@range(u16, genome.gSize)) |i| {
            reservoirGenome[i] = genomePtr[i];
        }
    }
}

// get fossil genome & reset window, falls back to 0th if reservoir empty
fn _take_fossil() [*]u32 {
    const useReservoir = (
        samplingMode_ == FossilSampling.reservoir and reservoirCount > 0
    );
    reservoirCount = 0;
    return if (useReservoir)
        @ptrcast([*]u32, &reservoirGenome)
    else
        population._get_ith_genome(0);
}

// public interface ===========================================================
/// Call once per generation, after population.do_generation.
fn update_sample() void {
    if (samplingMode_ == FossilSampling.reservoir) { _reservoir_sample(); }
}

/// Copy fossil genome into bookend buffer, w/ counter + tag bookends.
fn pull_sample(tag: u32) void {
    const genomePtr = _take_fossil();
    bookendBuffer[genome.gSize + 1] += 1;
    bookendBuffer[genome.gSize + 1] &= 0x3FF;  // clear upper bits
    bookendBuffer[genome.gSize + 1] |= tag << 10;  // set tag
    for (@range(u16, genome.gSize)) |i| {
        bookendBuffer[i + 1] = genomePtr[i];
    }
    bookendBuffer[0] += 1;
    bookendBuffer[0] &= 0x3FF;  // clear upper bits
    bookendBuffer[0] |= tag << 10;  // set tag
}

comptime {  // symbols let memcpy gather data from device to host
    if (@strlen(symbolName) > 0) {
        @export_symbol(ptr_bookendBuffer, symbolName);
    }
}
