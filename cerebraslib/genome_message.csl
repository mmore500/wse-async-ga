// Pack and unpack genome messages sent between PEs: a genome's low gBitsMsg
// bits, packed back to back, so messages under a word share words.

// module params ==============================================================
param gWordsPop: u16;  // genome.gWordsPop
param gBitsMsg: u16;  // genome.gBitsMsg

// compile-time configuration =================================================
comptime {
    @comptime_assert(gBitsMsg > 0);
    @comptime_assert(gBitsMsg <= 32 * gWordsPop);
}

// copy unit: largest power of two, up to a word, dividing gBitsMsg, so copy
// units never straddle words
const unitBits: u16 = (
    if (gBitsMsg % 32 == 0) 32
    else if (gBitsMsg % 16 == 0) 16
    else if (gBitsMsg % 8 == 0) 8
    else if (gBitsMsg % 4 == 0) 4
    else if (gBitsMsg % 2 == 0) 2
    else 1
);
const gSizeUnits: u16 = gBitsMsg / unitBits;
const unitMask: u32 = (
    if (unitBits == 32) 0xFFFFFFFF
    else (@as(u32, 1) << unitBits) - 1
);

// public API =================================================================
// how many words hold n packed messages?
fn words_for(n: u16) u16 { return (n * gBitsMsg + 31) / 32; }

// pack genome's message into buf as buf's ith message; buf must start zeroed
fn pack(srcPtr: [*]u32, destBuf: [*]u32, i: u16) void {
    for (@range(u16, gSizeUnits)) |k| {
        const srcBit = k * unitBits;  // bit offset into genome
        const destBit = (i * gSizeUnits + k) * unitBits;  // bit offset into buf
        const unit = (srcPtr[srcBit / 32] >> (srcBit % 32)) & unitMask;
        destBuf[destBit / 32] |= unit << (destBit % 32);
    }
}

// overwrite genome's message bits with buf's ith message
fn unpack(srcBuf: [*]u32, i: u16, destPtr: [*]u32) void {
    for (@range(u16, gSizeUnits)) |k| {
        const srcBit = (i * gSizeUnits + k) * unitBits;  // bit offset into buf
        const destBit = k * unitBits;  // bit offset into genome
        const unit = (srcBuf[srcBit / 32] >> (srcBit % 32)) & unitMask;
        destPtr[destBit / 32] = (
            (destPtr[destBit / 32] & ~(unitMask << (destBit % 32)))
            | (unit << (destBit % 32))
        );
    }
}
